<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ДЗ-колонки журнала (ДЗ 1 / ДЗ 2): поля из attendance_grades.py.
         Колонки и тумблеры добавляются xpath-ами к вьюхам openeducat_attendance,
         так как источник (sheet.homework_assignment_id) живёт в этом модуле. -->

    <!-- 1. Журнал урока (форма op.attendance.sheet): колонки ДЗ 1 / ДЗ 2
            после О2 + тумблеры массовых операций. -->
    <record id="view_op_attendance_sheet_form_hw" model="ir.ui.view">
        <field name="name">op.attendance.sheet.form.hw.grades</field>
        <field name="model">op.attendance.sheet</field>
        <field name="inherit_id" ref="openeducat_attendance.view_op_attendance_sheet_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mass_target_2']" position="after">
                <field name="mass_target_hw_1" widget="boolean_toggle" class="m-0"
                    title="ДЗ 1" invisible="not homework_assignment_id"/>
                <field name="mass_target_hw_2" widget="boolean_toggle" class="m-0"
                    title="ДЗ 2" invisible="not homework_assignment_id"/>
            </xpath>
            <xpath expr="//list//field[@name='grade_2_ui']" position="after">
                <field name="hw_grade_1_ui" string="ДЗ 1"
                    widget="selection_badge"
                    width="80px" optional="show"
                    readonly="not hw_assignment_id"
                    decoration-bf="1"
                    decoration-success="hw_grade_1_ui == '5'"
                    decoration-info="hw_grade_1_ui == '4'"
                    decoration-warning="hw_grade_1_ui == '3'"
                    decoration-danger="hw_grade_1_ui == '2'" />
                <field name="hw_grade_2_ui" string="ДЗ 2"
                    widget="selection_badge"
                    width="80px" optional="show"
                    readonly="not hw_assignment_id"
                    decoration-bf="1"
                    decoration-success="hw_grade_2_ui == '5'"
                    decoration-info="hw_grade_2_ui == '4'"
                    decoration-warning="hw_grade_2_ui == '3'"
                    decoration-danger="hw_grade_2_ui == '2'" />
                <field name="hw_assignment_id" column_invisible="True" />
            </xpath>
        </field>
    </record>

    <!-- 2. Электронный дневник (список op.attendance.line): колонки ДЗ
            read-only (ставятся из журнала или при проверке ДЗ). -->
    <record id="view_op_attendance_line_tree_hw" model="ir.ui.view">
        <field name="name">op.attendance.line.list.hw.grades</field>
        <field name="model">op.attendance.line</field>
        <field name="inherit_id" ref="openeducat_attendance.view_op_attendance_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='grade_2_ui']" position="after">
                <field name="hw_grade_1_ui" string="ДЗ 1" optional="hide"
                    widget="selection_badge" options="{'horizontal': true}"
                    decoration-success="hw_grade_1_ui == '5'"
                    decoration-info="hw_grade_1_ui == '4'"
                    decoration-warning="hw_grade_1_ui == '3'"
                    decoration-danger="hw_grade_1_ui == '2'" />
                <field name="hw_grade_2_ui" string="ДЗ 2" optional="hide"
                    widget="selection_badge" options="{'horizontal': true}"
                    decoration-success="hw_grade_2_ui == '5'"
                    decoration-info="hw_grade_2_ui == '4'"
                    decoration-warning="hw_grade_2_ui == '3'"
                    decoration-danger="hw_grade_2_ui == '2'" />
            </xpath>
        </field>
    </record>

    <!-- 3. Дашборд Успеваемости (op.subject.grades): в списках строк по
            четвертям выводятся только О1/О2, ДЗ-оценок не видно — хотя
            они уже учитываются в среднем балле и в гистограмме.
            Добавляем обе колонки скрытыми по умолчанию (optional="hide"):
            учитель включает их через «Настроить столбцы».

            Наследуем здесь, а не в openeducat_attendance: поля hw_grade_*_ui
            определены в этом модуле, а attendance от него не зависит. -->
    <record id="view_op_subject_grades_hw" model="ir.ui.view">
        <field name="name">op.subject.grades.hw.grades</field>
        <field name="model">op.subject.grades</field>
        <field name="inherit_id" ref="openeducat_attendance.view_op_subject_grades_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='q1_line_ids']//field[@name='grade_2']" position="after">
                <field name="hw_grade_1_ui" string="ДЗ 1" optional="hide"
                    widget="selection_badge" options="{'horizontal': true}"
                    decoration-success="hw_grade_1_ui == '5'"
                    decoration-info="hw_grade_1_ui == '4'"
                    decoration-warning="hw_grade_1_ui == '3'"
                    decoration-danger="hw_grade_1_ui == '2'"/>
                <field name="hw_grade_2_ui" string="ДЗ 2" optional="hide"
                    widget="selection_badge" options="{'horizontal': true}"
                    decoration-success="hw_grade_2_ui == '5'"
                    decoration-info="hw_grade_2_ui == '4'"
                    decoration-warning="hw_grade_2_ui == '3'"
                    decoration-danger="hw_grade_2_ui == '2'"/>
            </xpath>
            <xpath expr="//field[@name='q2_line_ids']//field[@name='grade_2']" position="after">
                <field name="hw_grade_1_ui" string="ДЗ 1" optional="hide"
                    widget="selection_badge" options="{'horizontal': true}"
                    decoration-success="hw_grade_1_ui == '5'"
                    decoration-info="hw_grade_1_ui == '4'"
                    decoration-warning="hw_grade_1_ui == '3'"
                    decoration-danger="hw_grade_1_ui == '2'"/>
                <field name="hw_grade_2_ui" string="ДЗ 2" optional="hide"
                    widget="selection_badge" options="{'horizontal': true}"
                    decoration-success="hw_grade_2_ui == '5'"
                    decoration-info="hw_grade_2_ui == '4'"
                    decoration-warning="hw_grade_2_ui == '3'"
                    decoration-danger="hw_grade_2_ui == '2'"/>
            </xpath>
            <xpath expr="//field[@name='q3_line_ids']//field[@name='grade_2']" position="after">
                <field name="hw_grade_1_ui" string="ДЗ 1" optional="hide"
                    widget="selection_badge" options="{'horizontal': true}"
                    decoration-success="hw_grade_1_ui == '5'"
                    decoration-info="hw_grade_1_ui == '4'"
                    decoration-warning="hw_grade_1_ui == '3'"
                    decoration-danger="hw_grade_1_ui == '2'"/>
                <field name="hw_grade_2_ui" string="ДЗ 2" optional="hide"
                    widget="selection_badge" options="{'horizontal': true}"
                    decoration-success="hw_grade_2_ui == '5'"
                    decoration-info="hw_grade_2_ui == '4'"
                    decoration-warning="hw_grade_2_ui == '3'"
                    decoration-danger="hw_grade_2_ui == '2'"/>
            </xpath>
            <xpath expr="//field[@name='q4_line_ids']//field[@name='grade_2']" position="after">
                <field name="hw_grade_1_ui" string="ДЗ 1" optional="hide"
                    widget="selection_badge" options="{'horizontal': true}"
                    decoration-success="hw_grade_1_ui == '5'"
                    decoration-info="hw_grade_1_ui == '4'"
                    decoration-warning="hw_grade_1_ui == '3'"
                    decoration-danger="hw_grade_1_ui == '2'"/>
                <field name="hw_grade_2_ui" string="ДЗ 2" optional="hide"
                    widget="selection_badge" options="{'horizontal': true}"
                    decoration-success="hw_grade_2_ui == '5'"
                    decoration-info="hw_grade_2_ui == '4'"
                    decoration-warning="hw_grade_2_ui == '3'"
                    decoration-danger="hw_grade_2_ui == '2'"/>
            </xpath>

            <!-- Остальные колонки тоже настраиваемые: без optional="..."
                 Odoo не показывает их в «Настроить столбцы». О1/О2/дата/
                 тема/посещаемость выставляем optional="show" — по умолчанию
                 видны, но учитель может скрыть. -->
            <xpath expr="//field[@name='q1_line_ids']//field[@name='attendance_date']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q1_line_ids']//field[@name='lesson_topic']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q1_line_ids']//field[@name='attendance_type_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q1_line_ids']//field[@name='grade_1']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q1_line_ids']//field[@name='grade_2']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q2_line_ids']//field[@name='attendance_date']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q2_line_ids']//field[@name='lesson_topic']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q2_line_ids']//field[@name='attendance_type_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q2_line_ids']//field[@name='grade_1']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q2_line_ids']//field[@name='grade_2']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q3_line_ids']//field[@name='attendance_date']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q3_line_ids']//field[@name='lesson_topic']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q3_line_ids']//field[@name='attendance_type_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q3_line_ids']//field[@name='grade_1']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q3_line_ids']//field[@name='grade_2']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q4_line_ids']//field[@name='attendance_date']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q4_line_ids']//field[@name='lesson_topic']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q4_line_ids']//field[@name='attendance_type_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q4_line_ids']//field[@name='grade_1']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='q4_line_ids']//field[@name='grade_2']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
</odoo>
