<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ДЗ-колонки журнала (ДЗ 1 / ДЗ 2): поля из attendance_grades.py.
         Колонки и тумблеры добавляются xpath-ами к вьюхам openeducat_attendance,
         так как источник (sheet.homework_assignment_id) живёт в этом модуле. -->

    <!-- 1. Журнал урока (форма op.attendance.sheet): колонки ДЗ 1 / ДЗ 2
            после О2 + тумблеры массовых операций. -->
    <record id="view_op_attendance_sheet_form_hw" model="ir.ui.view">
        <field name="name">op.attendance.sheet.form.hw.grades</field>
        <field name="model">op.attendance.sheet</field>
        <field name="inherit_id" ref="openeducat_attendance.view_op_attendance_sheet_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='mass_target_2']" position="after">
                <field name="mass_target_hw_1" widget="boolean_toggle" class="m-0"
                    title="ДЗ 1" invisible="not homework_assignment_id"/>
                <field name="mass_target_hw_2" widget="boolean_toggle" class="m-0"
                    title="ДЗ 2" invisible="not homework_assignment_id"/>
            </xpath>
            <xpath expr="//list//field[@name='grade_2_ui']" position="after">
                <field name="hw_grade_1_ui" string="ДЗ 1"
                    widget="selection_badge"
                    width="80px" optional="show"
                    readonly="not hw_assignment_id"
                    decoration-bf="1"
                    decoration-success="hw_grade_1_ui == '5'"
                    decoration-info="hw_grade_1_ui == '4'"
                    decoration-warning="hw_grade_1_ui == '3'"
                    decoration-danger="hw_grade_1_ui == '2'" />
                <field name="hw_grade_2_ui" string="ДЗ 2"
                    widget="selection_badge"
                    width="80px" optional="show"
                    readonly="not hw_assignment_id"
                    decoration-bf="1"
                    decoration-success="hw_grade_2_ui == '5'"
                    decoration-info="hw_grade_2_ui == '4'"
                    decoration-warning="hw_grade_2_ui == '3'"
                    decoration-danger="hw_grade_2_ui == '2'" />
                <field name="hw_assignment_id" column_invisible="True" />
            </xpath>
        </field>
    </record>

    <!-- 2. Электронный дневник (список op.attendance.line): колонки ДЗ
            read-only (ставятся из журнала или при проверке ДЗ). -->
    <record id="view_op_attendance_line_tree_hw" model="ir.ui.view">
        <field name="name">op.attendance.line.list.hw.grades</field>
        <field name="model">op.attendance.line</field>
        <field name="inherit_id" ref="openeducat_attendance.view_op_attendance_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='grade_2_ui']" position="after">
                <field name="hw_grade_1_ui" string="ДЗ 1" optional="hide"
                    widget="selection_badge" options="{'horizontal': true}"
                    decoration-success="hw_grade_1_ui == '5'"
                    decoration-info="hw_grade_1_ui == '4'"
                    decoration-warning="hw_grade_1_ui == '3'"
                    decoration-danger="hw_grade_1_ui == '2'" />
                <field name="hw_grade_2_ui" string="ДЗ 2" optional="hide"
                    widget="selection_badge" options="{'horizontal': true}"
                    decoration-success="hw_grade_2_ui == '5'"
                    decoration-info="hw_grade_2_ui == '4'"
                    decoration-warning="hw_grade_2_ui == '3'"
                    decoration-danger="hw_grade_2_ui == '2'" />
            </xpath>
        </field>
    </record>
</odoo>
