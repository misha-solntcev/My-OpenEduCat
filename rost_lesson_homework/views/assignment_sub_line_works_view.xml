<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Окно проверки работ по одному заданию (вариант 1).

        Здесь работают ШТАТНЫЕ фильтры по состояниям и ШТАТНЫЙ выбор строк
        (галочки в заголовке таблицы). Обе механики в Odoo существуют
        только в отдельном list view с search view над ним — во вложенном
        one2many внутри формы задания их нет, поэтому там пришлось бы
        конструировать и то и другое руками (проверено: домен не
        применялся к загруженным строкам, выбор был полем hw_marked).

        Окно одно на задание: домен задаётся кнопкой «Работы» на форме
        (action_hw_open_works), вкладок нет.
    -->

    <!-- ==================== Фильтры по состояниям ==================== -->
    <record id="view_op_assignment_sub_line_search" model="ir.ui.view">
        <field name="name">op.assignment.sub.line.search.hw</field>
        <field name="model">op.assignment.sub.line</field>
        <field name="arch" type="xml">
            <search string="Работы">
                <!-- Активный по умолчанию фильтр: ждут проверки.
                     Действующие работы — то, с чем учитель работает сейчас;
                     принятые и отклонённые тоже доступны, но явной кнопкой. -->
                <filter name="hw_wait"
                        string="Ждут проверки"
                        domain="[('state', '=', 'submit')]"/>
                <filter name="hw_nosub"
                        string="Не сдали"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="hw_change"
                        string="На доработке"
                        domain="[('state', '=', 'change')]"/>
                <filter name="hw_accept"
                        string="Принято"
                        domain="[('state', '=', 'accept')]"/>
                <filter name="hw_reject"
                        string="Отклонено"
                        domain="[('state', '=', 'reject')]"/>
                <separator/>
                <!-- Разбивка как в макете: сначала ученик. -->
                <filter name="group_student"
                        string="По ученикам"
                        context="{'group_by': 'student_id'}"/>
                <filter name="group_state"
                        string="По состояниям"
                        context="{'group_by': 'state'}"/>
                <field name="student_id"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <!-- ==================== Список работ ==================== -->
    <record id="view_op_assignment_sub_line_list_hw" model="ir.ui.view">
        <field name="name">op.assignment.sub.line.list.hw</field>
        <field name="model">op.assignment.sub.line</field>
        <field name="arch" type="xml">
            <!-- multi_edit="1" — штатная правка нескольких выбранных
                 строк одновременно: учитель может проставить оценки и
                 комментарии сразу десятку работ без кнопок.

                 delete="1" — удаление штатное, кнопкой «Действия» в
                 шапке списка. Раньше стоял delete="0", и админ не мог
                 удалить ответ ученика: base unlink разрешает удалять
                 сдачи с любой группой assignment_user, а вот запрет в
                 самом view блокировал кнопку независимо от прав.

                 Галочка выбора строк здесь одна — штатная, от list.
                 Поля hw_marked (своя галочка) здесь больше нет, колонка
                 удалена: из-за неё в списке было две чекбокса слева. -->
            <list string="Работы"
                  editable="bottom"
                  create="0"
                  delete="1"
                  multi_edit="1"
                  decoration-muted="state == 'draft'"
                  decoration-success="state == 'accept'"
                  decoration-warning="state == 'change'"
                  decoration-danger="state == 'reject'">
                <!--
                  Заполнить оценку и комментарий пачкой можно прямо в
                  колонках — это штатный multi_edit="1" выше.
                -->
                <!--
                  Массовые действия живут в меню «Действия» (ir.actions.server
                  с binding_model_id), а не кнопками над списком:
                  * пункты появляются в меню ТОЛЬКО при групповом выборе
                    строк — ровно то поведение, о котором Миша и просил;
                  * пункты видны сразу, без прокрутки к шапке;
                  * «Снять отметки» не нужен: галочки снимаются штатным
                    переключением, отдельный пункт лишь путает.

                  Пункты вызывают те же методы на строках, что и кнопки
                  раньше, — records в ir.actions.server это РОВНО
                  выбранные записи, поэтому подменять их поиском по полю
                  не нужно и «зацепить» чужое невозможно.
                -->
                <field name="student_id" readonly="1"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'accept'"
                       decoration-warning="state == 'change'"
                       decoration-danger="state == 'reject'"/>
                <field name="submission_date" readonly="1"
                       string="Сдал" optional="hide"/>
                <!--
                      Вложения ответа — те же файлы и тот же виджет, что у
                      ученика в форме сдачи, поэтому превью показывается
                      одинаково везде: у ученика, у учителя в списке, у
                      завуча и админа.

                      Ничего не скрываем и не дублируем: виджет сам рисует
                      превью для КАЖДОГО файла, а не только для первого,
                      и по тапу открывает его. Колонка видима (optional
                      по умолчанию show) — раньше она была спрятана в
                      optional="hide", и учитель видел ссылку вместо
                      картинки, хотя виджет умеет иначе.
                    -->
                <field name="note" string="Ответ ученика"
                       optional="show"/>
                <field name="attachment_ids" widget="many2many_binary"
                       string="Вложения"
                       options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.webp,.gif,.pdf'}"/>
                <field name="teacher_note"
                       string="Комментарий учителя"
                       optional="show"/>
                <field name="marks" string="Оценка"
                       optional="show"/>
                <field name="marks_2" string="Оценка 2"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ==================== Пункты меню «Действия» ==================== -->
    <!--
        binding_model_id привязывает пункт к модели op.assignment.sub.line,
        binding_view_types="list" — только к списку. Меню «Действия» в
        клиенте появляется при групповом выборе строк, поэтому пункты
        видны именно тогда, когда есть что применять.

        code вызывает метод на строках. records — это ровно те записи,
        которые выбраны галочками, поэтому действие не может задеть
        чужое: подменять выбор поиском по полю здесь не нужно.

        Права и sudo — как в методах models/assignment_hw_works.py:
        sudo() не используется намеренно (он снял бы record rules), роль
        проверяется на сервере.
    -->
    <record id="action_hw_accept_selected" model="ir.actions.server">
        <field name="name">Принять работы</field>
        <field name="model_id" ref="model_op_assignment_sub_line"/>
        <field name="binding_model_id" ref="model_op_assignment_sub_line"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[
            (4, ref('openeducat_assignment.group_op_assignment_user')),
            (4, ref('openeducat_assignment.group_teacher_assignment')),
            (4, ref('openeducat_core.group_op_faculty')),
            (4, ref('openeducat_core.group_op_back_office_admin')),
        ]"/>
        <field name="state">code</field>
        <field name="code">records.action_hw_accept_selected()</field>
    </record>

    <record id="action_hw_change_selected" model="ir.actions.server">
        <field name="name">Отправить на доработку</field>
        <field name="model_id" ref="model_op_assignment_sub_line"/>
        <field name="binding_model_id" ref="model_op_assignment_sub_line"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[
            (4, ref('openeducat_assignment.group_op_assignment_user')),
            (4, ref('openeducat_assignment.group_teacher_assignment')),
            (4, ref('openeducat_core.group_op_faculty')),
            (4, ref('openeducat_core.group_op_back_office_admin')),
        ]"/>
        <field name="state">code</field>
        <field name="code">records.action_hw_change_selected()</field>
    </record>

    <record id="action_hw_reject_selected" model="ir.actions.server">
        <field name="name">Отклонить работы</field>
        <field name="model_id" ref="model_op_assignment_sub_line"/>
        <field name="binding_model_id" ref="model_op_assignment_sub_line"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[
            (4, ref('openeducat_assignment.group_op_assignment_user')),
            (4, ref('openeducat_assignment.group_teacher_assignment')),
            (4, ref('openeducat_core.group_op_faculty')),
            (4, ref('openeducat_core.group_op_back_office_admin')),
        ]"/>
        <field name="state">code</field>
        <field name="code">records.action_hw_reject_selected()</field>
    </record>

    <!-- ==================== Окно ==================== -->
    <record id="action_op_assignment_works" model="ir.actions.act_window">
        <field name="name">Работы</field>
        <field name="res_model">op.assignment.sub.line</field>
        <field name="view_mode">list</field>
        <!-- view_id, а не views: запись ir.actions.act_window в XML
             описывается через view_mode + view_id, вложенный views тут
             не поддерживается схемой (import_xml.rng), а eval подставил
             строку 'list' вместо ссылки на view. -->
        <field name="view_id"
               ref="rost_lesson_homework.view_op_assignment_sub_line_list_hw"/>
        <field name="search_view_id"
               ref="rost_lesson_homework.view_op_assignment_sub_line_search"/>
        <field name="context">{'search_default_hw_wait': 1}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Работ по заданию нет</p>
            <p>Список заполняется, когда ученики сдают работу.</p>
        </field>
    </record>

</odoo>