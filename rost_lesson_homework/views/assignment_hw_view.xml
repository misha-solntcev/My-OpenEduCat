<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      ПК-форма задания (вариант П1) — по макету design/homework-pc-teacher-form-v2.html.

      Разделение по ролям сделано НЕ двумя view с groups_id, а элементами
      одной формы. Причина: 17 преподавателей test4 состоят и в
      group_student_assignment, две версии view показали бы им обе разом.

      Что убрано:
        * вкладка «Кому задано» — список одноклассников дублировал работы,
          а ученику показывал весь класс. Поле allocation_ids само скрыто
          (invisible="1"): его заполняет журнал урока при создании задания
          (attendance_sheet.py), учителю редактировать нечего;
        * служебные поля из шапки (assignment_type, reviewer, point) —
          в «Ещё ▾» они и были, отдельного смысла в виду не имеют.

      Что добавлено:
        * кнопка «Ответы на задание» перекрашена в btn-primary и
          подписана «Работы»; метод переопределён, она открывает окно
          с фильтрами по состояниям и штатным выбором строк;
        * сводка «Работы — N · сдали · принято · ждут · доработке»;
        * список своей работы для ученика — вместо чужого списка класса.

      Название — «Работы», а не «Сдачи»: «сдачи» калька с submissions.
      В миниаппе того же слова в интерфейсе нет, там сегменты
      «Проверить / На доработке / Проверено».
    -->

    <record id="view_op_assignment_form_hw" model="ir.ui.view">
        <field name="name">op.assignment.form.homework</field>
        <field name="model">op.assignment</field>
        <field name="inherit_id" ref="openeducat_assignment.view_op_assignment_form"/>
        <field name="arch" type="xml">

            <!-- Заголовок окна -->
            <xpath expr="//form" position="attributes">
                <attribute name="string">Домашнее задание</attribute>
            </xpath>

            <!-- Кнопки состояния: русские и правильные по смыслу -->
            <xpath expr="//button[@name='act_publish']" position="replace">
                <button name="action_hw_publish" type="object"
                        string="Выдать" class="oe_highlight"
                        invisible="state != 'draft'"
                        groups="openeducat_assignment.group_op_assignment_user,openeducat_core.group_op_faculty"/>
            </xpath>
            <xpath expr="//button[@name='act_set_to_draft']" position="attributes">
                <attribute name="string">Вернуть в черновик</attribute>
            </xpath>
            <xpath expr="//button[@name='act_finish']" position="replace">
                <button name="act_finish" type="object"
                        string="Завершить проверку" class="oe_highlight"
                        invisible="state != 'publish'"
                        groups="openeducat_assignment.group_op_assignment_user,openeducat_core.group_op_faculty"/>
            </xpath>
            <xpath expr="//button[@name='act_cancel']" position="attributes">
                <attribute name="string">Отозвать задание</attribute>
            </xpath>

            <!-- Кнопка «Ответы на задание» (get_assignment_submissions) —
                 единственная точка входа в работы задания. Вторую
                 кнопку «Работы» убрали: два источника правды на одно и
                 то же (Миша: «надо оставить один — это родная Ответы»).

                 Перекрашена под главную кнопку макета и подписана «Работы», чтобы
                 учитель видел привычное слово из интерфейса, а не кальку
                 «Submissions».

                 Класс оставлен oe_stat_button + btn-primary, а не просто
                 btn-primary: внутри кнопки живёт счётчик
                 assignment_sub_line_count с widget="statinfo". Убрав
                 oe_stat_button, мы бы сломали отрисовку счётчика —
                 проверено в итоговой разметке, class остаётся один.

                 Ученику не нужна и небезопасна (открывает все работы
                 по заданию), поэтому прячем по группам: проверено,
                 в архитектуре ученика кнопки нет вовсе.

                 Метод переопределён в models/assignment_hw_works.py:
                 открывает окно с фильтрами по состояниям и штатным
                 выбором строк, а не голый список без панели. -->
            <xpath expr="//button[@name='get_assignment_submissions']"
                   position="attributes">
                <attribute name="groups">openeducat_assignment.group_op_assignment_user,openeducat_core.group_op_faculty</attribute>
                <attribute name="string">Работы</attribute>
                <attribute name="icon">fa-list-alt</attribute>
                <attribute name="class">oe_stat_button btn btn-primary</attribute>
                <attribute name="type">object</attribute>
            </xpath>

            <!-- Служебные поля шапки: учителю не нужны, ученику тем более.
                 Само значение хранится, поле просто не показываем. -->
            <xpath expr="//field[@name='assignment_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='reviewer']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='point']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='issued_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- marks в базовой форме required="1": убрать из формы нельзя,
                 сломается создание задания. Переименовываем и прячем в
                 «Ещё ▾» нельзя — оставляем, но подпись человеческая. -->
            <xpath expr="//field[@name='marks']" position="attributes">
                <attribute name="string">Максимальный балл</attribute>
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Название -->
            <xpath expr="//h1/field[@name='name']" position="attributes">
                <attribute name="placeholder">Например: §14, вопросы 1–4</attribute>
            </xpath>

            <!--
              Ноутбук базовой формы разворачиваем ЦЕЛИКОМ (вариант 2, на
              котором остановились): вкладок нет вообще. Задание и список
              работ идут одним листом: сначала что задали, ниже кому и с
              каким статусом.

              Страница allocation_infomation не переносится: её содержимое
              (allocation_ids) уходит в скрытое поле, а детей теперь
              показывает список работ — те же дети, но со статусом сдачи.
              Само поле не удаляем: его заполняет журнал урока при создании
              задания (attendance_sheet.py), и на нём стоит рассылка в
              миниапп.
            -->
            <xpath expr="//notebook" position="replace">
                <field name="allocation_ids" invisible="1"/>

                <!--
                  ОДИН список работ — без вкладок. Учитель, завуч и админ
                  видят весь класс и могут проверять пачкой; ученик — только
                  свою строку, домен приходит с сервера (hw_sub_line_domain),
                  чужие работы не приезжают вообще, а не прячутся на клиенте.

                  Фильтров по состояниям в форме НЕТ и быть не может: фильтры в
                  Odoo живут только в search view над отдельным action,
                  а у вложенного one2many своего action нет. Домен из
                  `domain="hw_sub_line_domain"` клиент к уже загруженным
                  строкам не применяет — проверено вживую (кнопка меняла
                  подсветку, список оставался прежним). Поэтому работы
                  учителю открывает отдельное окно из кнопки «Ответы на
                  задание» (views/assignment_sub_line_works_view.xml).

                  Домен объявлен ОТДЕЛЬНО и вне групп: иначе у ученика (кто
                  список учителя не видит) поля нет в архитектуре, домен не
                  резолвится — и он получает все работы по заданию, включая
                  чужие. Проверено: так и вышло, ученик видел работу
                  одноклассника.
                -->
                <field name="hw_sub_line_domain" invisible="1"/>

                <!--
                  Четыре блока как в макете (homework-pc-teacher-form-v2.html):
                  Класс · Предмет · Срок сдачи · Урок. Класс и Предмет в
                  базовой форме не показаны, пришлось вывести явно — иначе
                  учитель не видит, кому и по какому предмету задано.
                -->
                <group name="hw_head">
                    <group name="hw_head_left">
                        <field name="batch_id" readonly="1"/>
                        <field name="subject_id" readonly="1"/>
                    </group>
                    <group name="hw_head_right">
                        <field name="submission_date"
                               readonly="state != 'draft'"/>
                        <field name="hw_sheet_id" readonly="1"
                               groups="openeducat_assignment.group_op_assignment_user,openeducat_core.group_op_faculty"/>
                    </group>
                </group>

                <label for="description" string="Текст задания"/>
                <field name="description" readonly="state !='draft'"
                       colspan="4"/>

                <!--
                  Полосы-сводки по состояниям в форме нет, по решению Миши.
                  Поначалу убрали только счётчик «не сдали», а
                  полосу оставили — это было неверное прочтение просьбы.

                  Числа всё равно показывают штатные фильтры окна работ,
                  но там их можно отфильтровать и получить ровно то же
                  число строк, а здесь цифры висят без возможности
                  посмотреть, откуда они взялись.

                  Поля-счётчики в модели оставлены: они считаются на
                  сервере и ещё понадобятся, но в интерфейсе не
                  показываются.
                -->

                <!--
                  Работы открывает ОДНА кнопка — штатная смарт-кнопка
                  «Ответы на задание» (get_assignment_submissions) в
                  button_box выше. Вторую кнопку «Работы» убрали: два
                  источника правды на одно и то же — учитель не должен
                  гадать, куда нажать (Миша: «надо оставить один»).

                  Метод get_assignment_submissions переопределён в
                  models/assignment_hw_works.py: он открывает окно
                  assignment_sub_line_works_view.xml, где есть штатные
                  фильтры по состояниям, штатные галочки выбора строк и
                  multi_edit. Раньше он отдавал action без search view,
                  поэтому фильтров там не было вовсе.

                  Своего JS нет.
                -->

                <div class="text-muted small"
                     invisible="assignment_sub_line"
                     groups="openeducat_assignment.group_op_assignment_user,openeducat_assignment.group_teacher_assignment,openeducat_core.group_op_faculty,openeducat_core.group_op_back_office_admin">
                    <i class="fa fa-info-circle me-1"/>
                    Работ пока нет. Список класса заполняется при выдаче
                    задания журналом урока; ученики сдают работу в миниаппе.
                </div>

                <!-- Ученику — только своя работа, без списка класса -->
                <div invisible="assignment_sub_line"
                     groups="openeducat_assignment.group_student_assignment">
                    <p class="text-muted">
                        <i class="fa fa-info-circle me-1"/>
                        Это задание ещё не сдано. Работу можно сдать
                        в миниаппе — до конца урока.
                    </p>
                </div>
                <field name="assignment_sub_line" nolabel="1"
                       domain="hw_sub_line_domain"
                       readonly="1"
                       invisible="not assignment_sub_line"
                       groups="openeducat_assignment.group_student_assignment">
                    <list string="Моя работа" create="0" delete="0">
                        <field name="state" widget="badge"
                               decoration-success="state == 'accept'"
                               decoration-warning="state == 'change'"
                               decoration-danger="state == 'reject'"/>
                        <field name="submission_date" readonly="1"
                               string="Сдал"/>
                        <field name="marks" string="Оценка"/>
                        <field name="teacher_note"
                               string="Комментарий учителя"/>
                        <field name="note" string="Мой ответ"/>
                        <field name="attachment_ids" widget="many2many_binary"
                               string="Мои вложения" readonly="1"
                               options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.webp,.gif,.pdf'}"/>
                    </list>
                </field>
            </xpath>

        </field>
    </record>

</odoo>