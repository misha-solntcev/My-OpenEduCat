<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      ПК-форма задания (вариант П1) — по макету design/homework-pc-teacher-form-v2.html.

      Разделение по ролям сделано НЕ двумя view с groups_id, а элементами
      одной формы. Причина: 17 преподавателей test4 состоят и в
      group_student_assignment, две версии view показали бы им обе разом.

      Что убрано:
        * вкладка «Кому задано» — список одноклассников дублировал работы,
          а ученику показывал весь класс. Поле allocation_ids само скрыто
          (invisible="1"): его заполняет журнал урока при создании задания
          (attendance_sheet.py), учителю редактировать нечего;
        * служебные поля из шапки (assignment_type, reviewer, point) —
          в «Ещё ▾» они и были, отдельного смысла в виду не имеют.

      Что добавлено:
        * фильтры списка работ — штатные кнопки Odoo (type="object",
          возвращают act_window с context hw_filter). Своего JS нет;
        * вкладка «Моя работа» для ученика — вместо чужого списка класса.

      Название — «Работы», а не «Сдачи»: «сдачи» калька с submissions.
      В миниаппе того же слова в интерфейсе нет, там сегменты
      «Проверить / На доработке / Проверено».
    -->

    <record id="view_op_assignment_form_hw" model="ir.ui.view">
        <field name="name">op.assignment.form.homework</field>
        <field name="model">op.assignment</field>
        <field name="inherit_id" ref="openeducat_assignment.view_op_assignment_form"/>
        <field name="arch" type="xml">

            <!-- Заголовок окна -->
            <xpath expr="//form" position="attributes">
                <attribute name="string">Домашнее задание</attribute>
            </xpath>

            <!-- Кнопки состояния: русские и правильные по смыслу -->
            <xpath expr="//button[@name='act_publish']" position="replace">
                <button name="action_hw_publish" type="object"
                        string="Выдать" class="oe_highlight"
                        invisible="state != 'draft'"
                        groups="openeducat_assignment.group_op_assignment_user,openeducat_core.group_op_faculty"/>
            </xpath>
            <xpath expr="//button[@name='act_set_to_draft']" position="attributes">
                <attribute name="string">Вернуть в черновик</attribute>
            </xpath>
            <xpath expr="//button[@name='act_finish']" position="replace">
                <button name="act_finish" type="object"
                        string="Завершить проверку" class="oe_highlight"
                        invisible="state != 'publish'"
                        groups="openeducat_assignment.group_op_assignment_user,openeducat_core.group_op_faculty"/>
            </xpath>
            <xpath expr="//button[@name='act_cancel']" position="attributes">
                <attribute name="string">Отозвать задание</attribute>
            </xpath>

            <!-- Кнопку «Ответы на задания» (get_assignment_submissions) учителю
                 оставляем: это единственный способ посмотреть сдачи задания
                 целиком. Ученику она не нужна и небезопасна (открывает все
                 работы по заданию), поэтому прячем по группам. -->
            <xpath expr="//button[@name='get_assignment_submissions']"
                   position="attributes">
                <attribute name="groups">openeducat_assignment.group_op_assignment_user,openeducat_core.group_op_faculty</attribute>
            </xpath>

            <!-- Служебные поля шапки: учителю не нужны, ученику тем более.
                 Само значение хранится, поле просто не показываем. -->
            <xpath expr="//field[@name='assignment_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='reviewer']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='point']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='issued_date']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- marks в базовой форме required="1": убрать из формы нельзя,
                 сломается создание задания. Переименовываем и прячем в
                 «Ещё ▾» нельзя — оставляем, но подпись человеческая. -->
            <xpath expr="//field[@name='marks']" position="attributes">
                <attribute name="string">Максимальный балл</attribute>
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Название -->
            <xpath expr="//h1/field[@name='name']" position="attributes">
                <attribute name="placeholder">Например: §14, вопросы 1–4</attribute>
            </xpath>

            <!--
              Вкладка «Кому задано» убирается целиком. Остаётся скрытое
              поле allocation_ids: его заполняет журнал урока при создании
              задания (OpAttendanceSheet._hw_create_assignment), и на этом
              строится рассылка в миниапп. Удалять поле нельзя.
            -->
            <xpath expr="//page[@name='allocation_infomation']" position="replace">
                <field name="allocation_ids" invisible="1"/>
            </xpath>

            <xpath expr="//page[@name='basic_information']" position="attributes">
                <attribute name="string">Задание</attribute>
            </xpath>
            <xpath expr="//label[@for='description']" position="attributes">
                <attribute name="string">Текст задания</attribute>
            </xpath>

            <!-- Срок: подпись и пояснение, откуда он взялся -->
            <xpath expr="//field[@name='submission_date']" position="before">
                <field name="hw_sheet_id" readonly="1"
                       groups="openeducat_assignment.group_op_assignment_user,openeducat_core.group_op_faculty"/>
            </xpath>

            <!--
              Вкладка «Работы». Учитель — весь класс списком и может
              проверять пачкой. Ученик — только своя строка: домен приходит
              с сервера (hw_sub_line_domain), чужие работы не приезжают
              вообще, а не прячутся на клиенте.

              Фильтры — штатные кнопки Odoo. Каждая возвращает act_window
              с context hw_filter, сервер подставляет домен по полю state.
            -->
            <!--
              Домен списка работ должен быть ОБЪЯВЛЕН ВНЕ вкладки учителя.
              Иначе у ученика (которому вкладка «Работы» не рендерится) поля
              нет в архитектуре, домен не резолвится — и он видит ВСЕ работы
              по заданию, включая чужие. Проверено: так и вышло, ученик видел
              работу одноклассника.
            -->
            <xpath expr="//notebook" position="before">
                <field name="hw_sub_line_domain" invisible="1"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page name="hw_submissions" string="Работы"
                      groups="openeducat_assignment.group_op_assignment_user,openeducat_core.group_op_faculty">
                    <!--
                      Фильтры — штатные кнопки Odoo. Каждая возвращает
                      act_window с context hw_filter; активная подсвечена.
                      Своего JS нет.
                    -->
                    <div class="mb-2" invisible="state == 'draft'">
                        <button name="action_hw_filter_all" type="object"
                                string="Все" class="btn btn-link p-0 me-3"
                                invisible="hw_filter and hw_filter != 'all'"/>
                        <button name="action_hw_filter_nosub" type="object"
                                string="Не сдали" class="btn btn-link p-0 me-3"
                                invisible="hw_filter and hw_filter != 'nosub'"/>
                        <button name="action_hw_filter_wait" type="object"
                                string="Ждут проверки" class="btn btn-link p-0 me-3"
                                invisible="hw_filter and hw_filter != 'wait'"/>
                        <button name="action_hw_filter_ok" type="object"
                                string="Принято" class="btn btn-link p-0 me-3"
                                invisible="hw_filter and hw_filter != 'ok'"/>
                        <button name="action_hw_filter_back" type="object"
                                string="На доработке" class="btn btn-link p-0"
                                invisible="hw_filter and hw_filter != 'back'"/>
                    </div>

                    <field name="assignment_sub_line" nolabel="1"
                           domain="hw_sub_line_domain"
                           context="{'default_assignment_id': id}">
                        <list string="Работы" editable="bottom"
                              create="0"
                              decoration-muted="state == 'draft'"
                              decoration-success="state == 'accept'"
                              decoration-warning="state == 'change'">
                            <field name="student_id" readonly="1"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'accept'"
                                   decoration-warning="state == 'change'"
                                   decoration-danger="state == 'reject'"/>
                            <field name="submission_date" readonly="1"
                                   string="Сдал" optional="hide"/>
                            <field name="note" string="Ответ ученика"
                                   optional="show"/>
                            <field name="attachment_ids" widget="many2many_binary"
                                   string="Вложения" optional="hide"
                                   options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.webp,.gif,.pdf'}"/>
                            <field name="teacher_note"
                                   string="Комментарий учителя"
                                   optional="show"/>
                            <field name="marks" string="Оценка"
                                   invisible="state != 'accept'"
                                   optional="show"/>
                            <field name="marks_2" string="Оценка 2"
                                   invisible="state != 'accept'"
                                   optional="hide"/>
                        </list>
                    </field>
                    <div class="text-muted small" invisible="assignment_sub_line">
                        <i class="fa fa-info-circle me-1"/>
                        Работ пока нет. Они появятся, когда ученики сдадут
                        задание в миниаппе, либо когда задание будет выдано
                        и список класса заполнен журналом урока.
                    </div>
                </page>

                <!-- Ученику вместо списка класса — его одна работа -->
                <page name="hw_my_work" string="Моя работа"
                      groups="openeducat_assignment.group_student_assignment"
                      invisible="assignment_sub_line">
                    <div class="text-muted small">
                        <i class="fa fa-info-circle me-1"/>
                        Это задание ещё не сдано. Работы можно сдать
                        в миниаппе — до конца урока.
                    </div>
                </page>
                <page name="hw_my_work_done" string="Моя работа"
                      groups="openeducat_assignment.group_student_assignment"
                      invisible="not assignment_sub_line">
                    <field name="assignment_sub_line" nolabel="1"
                           domain="hw_sub_line_domain"
                           readonly="1">
                        <list string="Моя работа" create="0" delete="0">
                            <field name="state" widget="badge"
                                   decoration-success="state == 'accept'"
                                   decoration-warning="state == 'change'"
                                   decoration-danger="state == 'reject'"/>
                            <field name="submission_date" readonly="1"
                                   string="Сдал"/>
                            <field name="marks" string="Оценка"/>
                            <field name="teacher_note"
                                   string="Комментарий учителя"/>
                            <field name="note" string="Мой ответ"/>
                            <field name="attachment_ids" widget="many2many_binary"
                                   string="Мои вложения" readonly="1"
                                   options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.webp,.gif,.pdf'}"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>