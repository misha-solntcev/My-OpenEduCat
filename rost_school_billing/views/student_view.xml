<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_student_form_contracts" model="ir.ui.view">
        <field name="name">op.student.form.contracts</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="priority" eval="13"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_contracts" type="object"
                        class="btn oe_stat_button" icon="fa-calendar"
                        groups="openeducat_fees.group_op_fees_admin">
                    <field name="contract_count" widget="statinfo"
                           string="Подписки"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_generate_doc" type="object"
                        string="Сгенерировать документ"
                        icon="fa-file-word-o"
                        groups="openeducat_admission.group_op_admission_user,base.group_system"/>
            </xpath>
        </field>
    </record>
</odoo>
