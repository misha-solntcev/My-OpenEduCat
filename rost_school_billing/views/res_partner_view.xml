<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_rost_docs" model="ir.ui.view">
        <field name="name">res.partner.form.rost.docs</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Паспорт и адреса" name="rost_doc_data"
                      groups="openeducat_admission.group_op_admission_user,base.group_system">
                    <group>
                        <group>
                            <field name="rost_birth_date"/>
                            <field name="rost_passport_number"/>
                            <field name="rost_passport_issue_date"/>
                            <field name="rost_passport_dept_code"/>
                        </group>
                        <group>
                            <field name="rost_passport_issued_by"/>
                            <field name="rost_address_reg"/>
                            <field name="rost_address_home"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
