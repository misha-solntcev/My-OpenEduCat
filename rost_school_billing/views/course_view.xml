<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_op_course_form_billing" model="ir.ui.view">
        <field name="name">op.course.form.billing</field>
        <field name="model">op.course</field>
        <field name="inherit_id" ref="openeducat_core.view_op_course_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Биллинг (помесячные подписки)" name="billing">
                    <field name="sale_order_template_id"/>
                    <field name="billing_pricelist_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
