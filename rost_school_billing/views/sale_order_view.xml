<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_admission" model="ir.ui.view">
        <field name="name">sale.order.form.admission (rost_school_billing)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_admission" type="object"
                        string="Поступление" class="btn-primary"
                        invisible="not sale_order_template_id"/>
                <!-- Анкета: отправка после подтверждения заказа -->
                <button name="action_zayavlenie_send" type="object"
                        string="Отправить анкету" icon="fa-paper-plane"
                        invisible="state != 'sale' or not opportunity_id or zayavlenie_state == 'filled'"/>
                <button name="action_open_zayavlenie" type="object"
                        string="Открыть анкету" icon="fa-external-link"
                        invisible="not opportunity_id or zayavlenie_state in ('none', False)"/>
                <button name="action_zayavlenie_new_link" type="object"
                        string="Новая ссылка" icon="fa-refresh"
                        invisible="state != 'sale' or not opportunity_id or zayavlenie_state in ('none', False)"/>
            </xpath>
            <!-- Статус анкеты полосой под шапкой: цвет = состояние,
                 текст = что делать дальше. Появляется только у
                 подтверждённого заказа (state = 'sale') -->
            <xpath expr="//header" position="after">
                <field name="zayavlenie_state" invisible="1"/>
                <div role="status" class="alert alert-info py-1 px-2 mb-0 mt-2"
                     invisible="not opportunity_id or state != 'sale' or zayavlenie_state != 'sent'">
                    Анкета отправлена родителю — ждём заполнения.
                </div>
                <div role="status" class="alert alert-success py-1 px-2 mb-0 mt-2"
                     invisible="not opportunity_id or state != 'sale' or zayavlenie_state != 'filled'">
                    Анкета заполнена родителем — можно выполнять «Поступление».
                </div>
                <div role="status" class="alert alert-warning py-1 px-2 mb-0 mt-2"
                     invisible="not opportunity_id or state != 'sale' or zayavlenie_state != 'expired'">
                    Срок ссылки на анкету истёк — нажмите «Новая ссылка»
                    и отправьте родителю заново.
                </div>
            </xpath>
            <!-- Флаг взноса обязан быть в подвидах строк: иначе onchange
                 шаблона вернёт его, но веб-клиент отбросит значение при
                 сохранении, и строка взноса попадёт в подписку как
                 учебный месяц (сдвиг всего графика на месяц). -->
            <xpath expr="//field[@name='order_line']//list" position="inside">
                <field name="charge_at_start" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//form" position="inside">
                <field name="charge_at_start" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_form_doc35" model="ir.ui.view">
        <field name="name">sale.order.form.doc35 (rost_school_billing)</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Договор" name="rost_doc35"
                      invisible="not sale_order_template_id">
                    <field name="doc_clause35"
                           placeholder="Условия п. 3.5 договора — из шаблона КП; здесь можно поправить в этом КП."/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
