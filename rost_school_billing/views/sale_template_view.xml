<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_template_charge_at_start" model="ir.ui.view">
        <field name="name">sale.order.template.charge.at.start</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_order_template_line_ids']//field[@name='product_uom_qty']" position="after">
                <field name="charge_at_start"/>
            </xpath>
        </field>
    </record>
</odoo>
