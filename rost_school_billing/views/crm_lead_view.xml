<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="crm_lead_view_form_student" model="ir.ui.view">
        <field name="name">crm.lead.form.student (rost_school_billing)</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="student" string="Ученик">
                    <group>
                        <group string="Ребёнок (новый ученик)">
                            <field name="child_name"/>
                            <field name="child_email"/>
                            <field name="child_birth_date"/>
                            <field name="child_gender"/>
                            <field name="child_course_id"/>
                            <field name="child_current_school"/>
                            <field name="child_interests"/>
                            <field name="child_medical"/>
                        </group>
                        <group string="Семья и согласия">
                            <field name="child_address"/>
                            <field name="personal_data_consent"/>
                            <field name="existing_student_id"/>
                            <div colspan="2" class="text-muted">
                                Заполните, если ребёнок уже числится в школе:
                                приёмка привяжется к нему, а не создаст нового.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
