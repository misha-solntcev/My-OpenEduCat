<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Жизненный цикл уроков: confirm -> start -> done по расписанию.
             Заменяет рукотворные Base Automation rules 18/19 (перенос в код).
             Тик каждые 5 минут — нагрузка минимальна: два индексных search
             по state + datetime. -->
        <record id="ir_cron_session_lifecycle" model="ir.cron">
            <field name="name">OpenEduCat: жизненный цикл уроков (start/done)</field>
            <field name="model_id" ref="openeducat_timetable.model_op_session"/>
            <field name="state">code</field>
            <field name="code">model._cron_advance_sessions()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
