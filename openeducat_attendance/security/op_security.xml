<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_all_op_attendance">
        <field name="name">Attendance</field>
        <field name="sequence">106</field>
    </record>

    <record id="module_category_openeducat_attendance" model="ir.module.category">
        <field name="name">Attendance Management</field>
        <field name="parent_id" ref="openeducat_attendance.module_category_all_op_attendance"/>
        <field name="sequence">17</field>
    </record>

    <record id="group_op_attendance_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_openeducat_attendance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_op_attendance_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_openeducat_attendance"/>
        <field name="implied_ids" eval="[(4, ref('openeducat_attendance.group_op_attendance_user'))]"/>
    </record>   

    <record model="ir.rule" id="manager_attendance_line_rule">
        <field name="name">Manager: Full Attendance Access</field>
        <field name="model_id" ref="model_op_attendance_line"/>
        <field name="groups" eval="[(4, ref('openeducat_attendance.group_op_attendance_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record model="ir.rule" id="attendance_type_multi_comp_rule">
        <field name="name">Attendance Type: Multi-Company</field>
        <field name="model_id" ref="openeducat_attendance.model_op_attendance_type"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', '|', ('company_id','=',False), ('company_id','child_of',[user.company_id.id]), ('company_id','in',user.company_ids.ids)]</field>
    </record>

    <!-- ==================== ROST per-module role groups ====================
         Перенесены из rost_school_access 2026-08-28 (разрыв циклической зависимости):
         ACL этого модуля ссылаются на эти группы, поэтому они обязаны жить здесь. -->
    <record id="group_teacher_attendance" model="res.groups">
        <field name="name">Учитель</field>
        <field name="category_id" ref="module_category_openeducat_attendance"/>
        <field name="comment">Учитель: журналы посещаемости и оценки</field>
    </record>
    <record id="group_student_attendance" model="res.groups">
        <field name="name">Ученик</field>
        <field name="category_id" ref="module_category_openeducat_attendance"/>
        <field name="comment">Ученик: свои посещаемость и оценки</field>
    </record>

    <!-- Правило на write карточек успеваемости: учитель выставляет итоги
         четверти/года только в СВОИХ карточках. faculty_id карточки —
         преподаватель предмета в этом классе (compute по последней сессии
         subject×batch). perm_read=False — чтение не сужается (учитель видит
         все карточки); create/unlink закрыты: карточки создаёт система
         (крон + _transfer_grades_to_stats), вручную — только back-office
         admin (ACL access_op_subject_grades_admin). -->
    <record model="ir.rule" id="teacher_subject_grades_write_rule">
        <field name="name">Teacher: write own subject grades cards</field>
        <field name="model_id" ref="model_op_subject_grades"/>
        <field name="groups"
               eval="[(4, ref('openeducat_attendance.group_teacher_attendance'))]"/>
        <field name="domain_force">[('faculty_id.user_id','=',user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Back-office admin: полный write (правила групп объединяются по OR,
         поэтому у админа, состоящего ещё и в «Учителе», сужение снимается). -->
    <record model="ir.rule" id="admin_subject_grades_write_rule">
        <field name="name">Back-office admin: write all subject grades cards</field>
        <field name="model_id" ref="model_op_subject_grades"/>
        <field name="groups"
               eval="[(4, ref('openeducat_core.group_op_back_office_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>