<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- library.set (шаблон комплекта) -->
    <record id="view_library_set_tree" model="ir.ui.view">
        <field name="name">library.set.list</field>
        <field name="model">library.set</field>
        <field name="arch" type="xml">
            <list string="Комплекты">
                <field name="name"/>
                <field name="course_id"/>
            </list>
        </field>
    </record>

    <record id="view_library_set_form" model="ir.ui.view">
        <field name="name">library.set.form</field>
        <field name="model">library.set</field>
        <field name="arch" type="xml">
            <form string="Комплект">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="course_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Состав комплекта">
                            <field name="media_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_library_set" model="ir.actions.act_window">
        <field name="name">Комплекты</field>
        <field name="res_model">library.set</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- library.set.issue (выдача комплекта) -->
    <record id="view_library_set_issue_tree" model="ir.ui.view">
        <field name="name">library.set.issue.list</field>
        <field name="model">library.set.issue</field>
        <field name="arch" type="xml">
            <list string="Выдачи комплектов"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'issued'"
                  decoration-warning="state == 'partial_return'"
                  decoration-muted="state == 'returned'">
                <field name="name"/>
                <field name="set_id"/>
                <field name="library_card_id"/>
                <field name="issued_date"/>
                <field name="return_date"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'issued'"
                       decoration-muted="state == 'returned'"/>
            </list>
        </field>
    </record>

    <record id="view_library_set_issue_form" model="ir.ui.view">
        <field name="name">library.set.issue.form</field>
        <field name="model">library.set.issue</field>
        <field name="arch" type="xml">
            <form string="Выдача комплекта">
                <header>
                    <button name="action_pick_units"
                            string="Подобрать экземпляры"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ('draft', 'returned')"/>
                    <button name="action_issue"
                            string="Выдать комплект"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_return_all"
                            string="Сдать комплект"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ('issued', 'partial_return')"/>
                    <button name="action_reset_to_draft"
                            string="Сбросить в черновик"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'returned'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,issued,partial_return,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="set_id"
                                   readonly="state != 'draft'"/>
                            <field name="library_card_id"
                                   readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="issued_date"
                                   readonly="state != 'draft'"/>
                            <field name="return_date"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Экземпляры">
                            <field name="unit_ids" readonly="state != 'draft'">
                                <list string="Подобранные экземпляры">
                                    <field name="name"/>
                                    <field name="media_id"/>
                                    <field name="barcode"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Примечания">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_library_set_issue" model="ir.actions.act_window">
        <field name="name">Выдачи комплектов</field>
        <field name="res_model">library.set.issue</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
