<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_student_library_card">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- КАРТОЧКА (бэйдж) -->
                        <div
                            style="width: 400px; margin: 30px auto 0; border: 2px solid #2d4383; border-radius: 8px; overflow: hidden;">
                            <!-- Шапка карточки: текст слева, логотип справа -->
                            <table width="100%" style="border-collapse: collapse;">
                                <tr>
                                    <td
                                        style="background-color: #2d4383; color: white; font-size: 13px; font-weight: 700; padding: 6px 12px;">Библиотечная
                                        карточка</td>
                                    <td
                                        style="background-color: #2d4383; text-align: right; padding: 4px 10px;">
                                        <img t-att-src="image_data_uri(res_company.logo)"
                                            style="height: 56px; background: white; border-radius: 4px; padding: 2px;" />
                                    </td>
                                </tr>
                            </table>
                            <!-- Тело: фото слева, текст справа от фото -->
                            <table width="100%" style="border-collapse: collapse;">
                                <tr>
                                    <td
                                        style="padding: 10px 12px; width: 100px; vertical-align: top;">
                                        <img t-if="o.image_1920"
                                            t-att-src="image_data_uri(o.image_1920)"
                                            style="width: 90px; border: 1px solid #ccc; border-radius: 4px;" />
                                    </td>
                                    <td
                                        style="padding: 10px 12px 10px 4px; font-size: 12px; vertical-align: top;">
                                        <div style="margin-bottom: 4px;">
                                            <span style="font-weight: 700;">ФИО: </span>
                                            <span t-field="o.last_name" />
                                            <span t-field="o.first_name" />
                                        </div>
                                        <div style="margin-bottom: 4px;">
                                            <span style="font-weight: 700;">№ билета: </span>
                                            <span t-field="o.library_card_id.number" />
                                        </div>
                                        <div style="margin-bottom: 4px;">
                                            <span style="font-weight: 700;">Тип: </span>
                                            <span
                                                t-field="o.library_card_id.library_card_type_id.name" />
                                        </div>
                                        <div>
                                            <span style="font-weight: 700;">Выдан: </span>
                                            <span t-field="o.library_card_id.issue_date"
                                                t-options="{'widget': 'date'}" />
                                        </div>
                                    </td>
                                </tr>
                            </table>
                            <!-- Штрихкод по центру карточки -->
                            <div t-if="o.library_card_id.number"
                                style="text-align: center; padding: 10px 12px;">
                                <img
                                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', o.library_card_id.number, 300, 40)"
                                    style="height: 40px;" />
                            </div>
                        </div>

                        <!-- ВЫДАННЫЕ КНИГИ -->
                        <t t-set="issued"
                            t-value="env['op.media.movement'].search([('student_id', '=', o.id), ('state', '=', 'issue')])" />
                        <div style="margin: 25px 0 0; font-size: 13px;" t-if="issued">
                            <p style="font-size: 15px; font-weight: 700; margin-bottom: 6px;">
                                Выданные книги:
                            </p>
                            <table width="100%" style="border-collapse: collapse; font-size: 13px;">
                                <thead>
                                    <tr style="background-color: #2d4383; color: white;">
                                        <th
                                            style="border: 1px solid #ccc; padding: 5px 8px; font-size: 13px;">
                                            Книга</th>
                                        <th style="border: 1px solid #ccc; padding: 5px 8px;">
                                            Штрих-код</th>
                                        <th style="border: 1px solid #ccc; padding: 5px 8px;">Номер</th>
                                        <th style="border: 1px solid #ccc; padding: 5px 8px;">Дата
                                            выдачи</th>
                                        <th style="border: 1px solid #ccc; padding: 5px 8px;">Вернуть
                                            до</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="issued" t-as="m">
                                        <td style="border: 1px solid #ccc; padding: 5px 8px;">
                                            <span t-field="m.media_id.name" />
                                        </td>
                                        <td
                                            style="border: 1px solid #ccc; padding: 5px 8px; width: 45%;">
                                            <img
                                                t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', m.barcode, 380, 40)"
                                                style="width: 100%; height: 40px;" t-if="m.barcode" />
                                        </td>
                                        <td style="border: 1px solid #ccc; padding: 5px 8px;">
                                            <span t-field="m.barcode" />
                                        </td>
                                        <td style="border: 1px solid #ccc; padding: 5px 8px;">
                                            <span t-field="m.issued_date"
                                                t-options="{'widget': 'date'}" />
                                        </td>
                                        <td style="border: 1px solid #ccc; padding: 5px 8px;">
                                            <span t-field="m.return_date"
                                                t-options="{'widget': 'date'}" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <p style="margin-top: 40px; font-size: 14px; line-height: 2;">
                                Получил(а) <t t-out="len(issued)" /> книг(и), обязуюсь вернуть в
                                срок.<br /> Подпись ученика: ______________________ Дата: «___»
                                ____________ 20___ г. </p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>