<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Ссылка установки пароля: 24 часа вместо ядровых 6 дней.
             Текст писем ниже обещает именно 24 часа. -->
        <record id="rost_signup_validity_hours" model="ir.config_parameter">
            <field name="key">auth_signup.signup.validity.hours</field>
            <field name="value">24</field>
        </record>

        <!-- Приглашение родителя (режим А: единственный аккаунт семьи;
             режим Б: аккаунт для мамы). -->
        <record id="mail_template_rost_invite_parent" model="mail.template">
            <field name="name">Учёба: приглашение родителя (Аккаунт родителя)</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Аккаунт родителя — ЧОУ СПБГШ «РОСТ»</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin:0 auto;max-width:560px;font-family:Verdana,Arial,sans-serif;color:#454748;font-size:13px;line-height:1.6">
  <p>Здравствуйте!</p>
  <p>Для вашей семьи создан <b>аккаунт родителя</b> в школе «РОСТ».
  Через него вы видите оценки, домашние задания и расписание своих детей
  в мини-приложении «Школа РОСТ».</p>
  <p><b>Логин</b> — ваш e-mail: <b>{{ object.email }}</b><br/>
  Задайте пароль по ссылке (действует 24 часа):</p>
  <p style="margin:20px 0">
    <a href="{{object.partner_id._get_signup_url()}}"
       style="background-color:#714B67;color:#ffffff;padding:10px 18px;text-decoration:none;border-radius:4px;font-size:13px">
      Задать пароль и войти
    </a>
  </p>
  <p>Если вы не ожидали этого письма — просто проигнорируйте его,
  аккаунт останется неактивным.</p>
  <p>С уважением,<br/>школа «РОСТ»<br/>
  {{ object.company_id.phone or '' }} | {{ object.company_id.email or '' }}</p>
</div>
            </field>
        </record>

        <!-- Приглашение ученику (режим Б: у ребёнка своя почта). -->
        <record id="mail_template_rost_invite_student" model="mail.template">
            <field name="name">Учёба: приглашение ученика (Аккаунт ученика)</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="subject">Аккаунт ученика — ЧОУ СПБГШ «РОСТ»</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin:0 auto;max-width:560px;font-family:Verdana,Arial,sans-serif;color:#454748;font-size:13px;line-height:1.6">
  <p>Здравствуйте, <b>{{ object.name }}</b>!</p>
  <p>Для вас создан <b>учебный аккаунт</b> в школе «РОСТ»: с ним видны
  ваше расписание, домашние задания и оценки.</p>
  <p><b>Логин</b> — эта электронная почта: <b>{{ object.email }}</b><br/>
  Задайте пароль по ссылке (действует 24 часа):</p>
  <p style="margin:20px 0">
    <a href="{{object.partner_id._get_signup_url()}}"
       style="background-color:#714B67;color:#ffffff;padding:10px 18px;text-decoration:none;border-radius:4px;font-size:13px">
      Задать пароль и войти
    </a>
  </p>
  <p>Если вы не ожидали этого письма — просто проигнорируйте его,
  аккаунт останется неактивным.</p>
  <p>С уважением,<br/>школа «РОСТ»<br/>
  {{ object.company_id.phone or '' }} | {{ object.company_id.email or '' }}</p>
</div>
            </field>
        </record>
    </data>
</odoo>
