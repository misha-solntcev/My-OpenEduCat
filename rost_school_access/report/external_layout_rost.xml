<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Фирменная шапка РОСТ: вариант 4 — вертикальная синяя линия слева,
         лого + название, контакты справа. Подключение в отчетах:
             <t t-foreach="docs" t-as="o">
                 <t t-call="rost_school_access.external_layout_rost">
                     ... содержимое страницы (доступна переменная o) ...
                 </t>
             </t>
    -->
    <template id="external_layout_rost" name="ROST Header Layout">
        <!-- ШАПКА -->
        <div class="header o_layout_rost_header">
            <table width="100%" style="border-collapse: collapse;">
                <tr>
                    <td style="width: 6px; background-color: #2d4383; padding: 0;"></td>
                    <td style="padding: 6px 0 6px 16px; width: 130px; vertical-align: middle;">
                        <img t-att-src="'/rost_school_access/static/description/logo_rost.png'"
                             style="height: 80px;" alt="РОСТ"/>
                    </td>
                    <td style="vertical-align: middle;">
                        <div style="font-size: 17px; font-weight: 700; color: #2d4383;">ЧОУ СПбГШ «РОСТ»</div>
                        <div style="font-size: 11px; color: #555555; margin-top: 2px;">Библиотека</div>
                    </td>
                    <td style="text-align: right; vertical-align: middle;">
                        <div style="font-size: 11px; color: #555555; line-height: 1.7;">
                            Санкт-Петербург, Парнас,<br/>
                            улица Николая Рубцова, дом 5<br/>
                            +7 921 631-25-50 &amp;middot; info@rostschoolspb.ru
                        </div>
                    </td>
                </tr>
            </table>
        </div>

        <!-- СОДЕРЖИМОЕ СТРАНИЦЫ (class="article" обязателен: _prepare_html
             оборачивает его в web.minimal_layout с <base href> и charset,
             без него ломаются относительные URL — штрихкоды, ассеты) -->
        <div class="article">
            <div class="page">
                <t t-out="0"/>
            </div>
        </div>

        <!-- ПОДВАЛ -->
        <div class="footer o_layout_rost_footer">
            <div style="border-top: 1px solid #dddddd; margin-top: 20px; padding-top: 6px; text-align: center; font-size: 10px; color: #888888;">
                ЧОУ СПбГШ «РОСТ» &amp;middot; rostschoolspb.ru
            </div>
        </div>
    </template>

</odoo>
