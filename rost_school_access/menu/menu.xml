<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ROST School: меню приложений OpenEduCat для учеников.

        ВАЖНО: везде используется (6,0,[...]) — ПОЛНЫЙ список групп.
        Команда (4, ...) только добавляет группу и не убирает лишние:
        состояние БД перестаёт совпадать с XML. Полный список делает
        XML единственным источником истины при каждом -u.

        У подменю с action группы обязательны — Odoo скрывает пункт,
        если у пользователя нет ни одной его группы, даже если root видим.
    -->

    <!-- ===== Школа (SIS) ===== -->
    <record id="openeducat_core.menu_op_school_root" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_core.group_op_faculty'), ref('openeducat_core.group_op_back_office_admin'), ref('openeducat_core.group_op_students')])]"/>
    </record>
    <record id="openeducat_core.menu_op_school_main" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_core.group_op_back_office_admin'), ref('openeducat_core.group_op_faculty'), ref('openeducat_core.group_op_students')])]"/>
    </record>
    <!-- «Информация об обучении» / «Регистрация предметов» / «Предметы»: без Student —
         иначе ученик видит всех учеников школы и справочники. -->
    <record id="openeducat_core.student_course_menu" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_core.group_op_back_office_admin'), ref('openeducat_core.group_op_faculty')])]"/>
    </record>
    <record id="openeducat_core.subject_registration_student_menu" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_core.group_op_back_office_admin'), ref('openeducat_core.group_op_faculty')])]"/>
    </record>
    <record id="openeducat_core.menu_op_subject_sub" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_core.group_op_back_office_admin'), ref('openeducat_core.group_op_faculty')])]"/>
    </record>

    <!-- ===== Расписание ===== -->
    <!-- Ученикам — свой экшен БЕЗ дефолтного фильтра «Мои уроки»
         (search_default_my_sessions в act_open_op_session_view фильтрует по
         faculty_id.user_id — у ученика нет op.faculty, он видел бы пустоту).
         Ученик и так видит только уроки своего класса (student_session_rule). -->
    <record id="act_open_op_session_view_student" model="ir.actions.act_window">
        <field name="name">Расписание</field>
        <field name="res_model">op.session</field>
        <field name="view_mode">calendar,kanban,list,pivot,graph,form</field>
        <field name="search_view_id" ref="openeducat_timetable.view_op_session_search"/>
        <field name="context">{'search_default_current_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                На выбранную неделю уроков нет.
            </p>
        </field>
    </record>
    <!-- Меню «Расписание» для учеников (те же группы, что давали root-меню) -->
    <menuitem id="menu_op_timetable_student"
              name="Расписание"
              parent="openeducat_timetable.menu_op_timetable_root"
              groups="openeducat_timetable.group_student_timetable"
              action="act_open_op_session_view_student"
              sequence="5"/>
    <record id="openeducat_timetable.menu_op_timetable_root" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_timetable.group_op_timetable_user'), ref('openeducat_timetable.group_op_timetable_manager'), ref('openeducat_timetable.group_teacher_timetable'), ref('openeducat_timetable.group_student_timetable')])]"/>
    </record>
    <!-- Подменю «Уроки»: учителю нужен доступ к расписанию (просмотр) -->
    <record id="openeducat_timetable.menu_op_timetable" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_timetable.group_op_timetable_user'), ref('openeducat_timetable.group_op_timetable_manager'), ref('openeducat_timetable.group_teacher_timetable')])]"/>
    </record>

    <!-- ===== Успеваемость (attendance) ===== -->
    <record id="openeducat_attendance.menu_op_attendance_root" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_attendance.group_op_attendance_user'), ref('openeducat_attendance.group_op_attendance_manager'), ref('openeducat_attendance.group_teacher_attendance'), ref('openeducat_attendance.group_student_attendance')])]"/>
    </record>
    <!-- Дашборд оценок (Current Grades / subject.grades.kanban): учителя и ученики.
         В XML модуля у меню стояли только user/manager + core-группы —
         Ермакова (group_teacher_attendance) не видела его. -->
    <record id="openeducat_attendance.menu_op_subject_grades_kanban" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_attendance.group_op_attendance_user'), ref('openeducat_attendance.group_op_attendance_manager'), ref('openeducat_attendance.group_teacher_attendance'), ref('openeducat_attendance.group_student_attendance')])]"/>
    </record>
    <!-- Журналы уроков: только учителя (там оценки всего класса).
         Электронный дневник: ученик видит свои строки оценок
         (rule student_no_attendance_line_rule сужает до себя). -->
    <record id="openeducat_attendance.menu_op_attendance_sheet_sub" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_attendance.group_op_attendance_user'), ref('openeducat_attendance.group_op_attendance_manager'), ref('openeducat_attendance.group_teacher_attendance')])]"/>
    </record>
    <record id="openeducat_attendance.menu_op_attendance_line_sub" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_attendance.group_op_attendance_user'), ref('openeducat_attendance.group_op_attendance_manager'), ref('openeducat_attendance.group_teacher_attendance'), ref('openeducat_attendance.group_student_attendance')])]"/>
    </record>

    <!-- Отчёты: только учителя. Текущие оценки и PDF-выписки —
         общешкольные, ученику не нужны. -->
    <record id="openeducat_attendance.menu_op_attendance_reports" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_attendance.group_op_attendance_user'), ref('openeducat_attendance.group_op_attendance_manager'), ref('openeducat_attendance.group_teacher_attendance')])]"/>
    </record>
    <record id="openeducat_attendance.menu_current_grades_report" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_attendance.group_teacher_attendance')])]"/>
    </record>

    <!-- ===== Задания: root + пункты с action ===== -->
    <record id="openeducat_assignment.menu_op_assignment_root" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_assignment.group_op_assignment_user'), ref('openeducat_assignment.group_op_assignment_manager'), ref('openeducat_assignment.group_teacher_assignment'), ref('openeducat_assignment.group_student_assignment')])]"/>
    </record>
    <!-- Промежуточное меню «Задания» (без action) + список заданий: учителю тоже -->
    <record id="openeducat_assignment.menu_op_assignment_main" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('openeducat_assignment.group_teacher_assignment'), ref('openeducat_assignment.group_student_assignment')])]"/>
    </record>
    <!-- Список заданий (action): учителю тоже; ACL через *_faculty в CSV -->
    <record id="openeducat_assignment.menu_op_assignment_sub" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_assignment.group_op_assignment_user'), ref('openeducat_assignment.group_op_assignment_manager'), ref('openeducat_assignment.group_teacher_assignment'), ref('openeducat_assignment.group_student_assignment')])]"/>
    </record>
    <record id="openeducat_assignment.menu_op_assignment_sub_line_sub" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('openeducat_assignment.group_student_assignment')])]"/>
    </record>

    <!-- ===== Библиотека: скрыто от учеников (каталог бесполезен без прав открытия).
         Свои книги доступны через смарт-кнопку в карточке ученика. ===== -->
    <record id="openeducat_library.menu_op_library_root" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_library.group_op_library_user'), ref('openeducat_library.group_op_library')])]"/>
    </record>

    <!-- ===== Банковские счета: только бухгалтерия. Меню из модуля contacts
         не имеют групп по умолчанию => видны всем internal. ===== -->
    <record id="contacts.menu_config_bank_accounts" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('account.group_account_invoice')])]"/>
    </record>
    <record id="contacts.menu_action_res_partner_bank_form" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('account.group_account_invoice')])]"/>
    </record>
    <record id="contacts.menu_action_res_bank_form" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('account.group_account_invoice')])]"/>
    </record>
</odoo>
