<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        ROST School: вьюхи, ранее созданные вручную через UI (без xmlid).
        Перенесены в код 2026-08-26, группы __custom__.* заменены на актуальные.

        Смысл правок:
        - Чаттер сдачи ДЗ ПОКАЗАН ВСЕМ: переписка ученик↔учитель живёт в
          штатном mail.thread строки сдачи (2026-10). Прежняя вьюха
          view_assignment_sub_line_hide_chatter скрыла чаттер от учеников —
          удалена. Права всё равно режутся ACL/record rules (mail.message
          «User: All Chatter», ученики internal с 2026-09).
        - Кнопки расписания: учителя через per-module роль Учитель (timetable)
        - Кнопки выдачи книг в библиотеке: пермодульная роль Учитель (assignment)
        - Канбан преподавателей: ученикам отдельный шаблон без клика-открытия
        - Оценка/примечание в сдаче задания: у учеников readonly
    -->

    <!-- Скрытие Chatter снято кодом прошлой правки (вьюха удалена из
         data-файла). Явный <delete> после первого прогона больше не
         нужен: на test4 запись уже удалена, второй прогон падал
         ValueError (xmlid не существует). На проде удалить руками:
         ir_model_data/view_assignment_sub_line_hide_chatter ->
         unlink записи ir.ui.view.
    -->

    <!-- ===== op.session: кнопки формы видны и учителям =====

         В Odoo position="attributes" применяется ТОЛЬКО к первому
         совпавшему узлу. Выражение "//header/button" матчит все шесть кнопок
         шапки, но атрибут groups доезжал лишь до lecture_confirm — из-за
         чего учитель видел в форме 2 кнопки из 7 (пропали «Начать урок»,
         «Завершить», «Отменить урок», «Восстановить», «Редактировать»).
         Воспроизведено на test4 и на проде: BTN_COUNT 2.

         Поэтому перечисляем кнопки ПО ИМЕНИ, по одному xpath на каждую.
         Новую кнопку в header базовой вьюхи надо будет дописать сюда же.
    -->
    <record id="view_session_buttons_faculty" model="ir.ui.view">
        <field name="name">Добавляем группу учителей к кнопкам</field>
        <field name="model">op.session</field>
        <field name="inherit_id" ref="openeducat_timetable.view_op_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='lecture_confirm']" position="attributes">
                <attribute name="groups">openeducat_timetable.group_op_timetable_user,openeducat_timetable.group_teacher_timetable</attribute>
            </xpath>
            <xpath expr="//header/button[@name='lecture_start']" position="attributes">
                <attribute name="groups">openeducat_timetable.group_op_timetable_user,openeducat_timetable.group_teacher_timetable</attribute>
            </xpath>
            <xpath expr="//header/button[@name='lecture_done']" position="attributes">
                <attribute name="groups">openeducat_timetable.group_op_timetable_user,openeducat_timetable.group_teacher_timetable</attribute>
            </xpath>
            <xpath expr="//header/button[@name='lecture_cancel']" position="attributes">
                <attribute name="groups">openeducat_timetable.group_op_timetable_user,openeducat_timetable.group_teacher_timetable</attribute>
            </xpath>
            <xpath expr="//header/button[@name='lecture_draft']" position="attributes">
                <attribute name="groups">openeducat_timetable.group_op_timetable_user,openeducat_timetable.group_teacher_timetable</attribute>
            </xpath>
            <xpath expr="//header/button[@name='lecture_edit']" position="attributes">
                <attribute name="groups">openeducat_timetable.group_op_timetable_user,openeducat_timetable.group_teacher_timetable</attribute>
            </xpath>
        </field>
    </record>

    <!-- ===== op.session: форма урока учителю только для чтения =====

         Учитель попадает в форму через кнопку Edit в попапе календаря —
         это единственный путь к журналу (из формы кнопка «Attendance
         Sheet»). Раньше форма была полностью редактируемой: учитель
         мог поменять «1 урок» на «3 урок», предмет, класс, кабинет и
         время. Сдвиг времени ломает пару уроков в паре, а смена
         предмета/класса — расписание целиком.

         Снять права на write нельзя: учителю нужен write в op.session
         для кнопок «Начать урок» / «Завершить» (lecture_start/done).
         Поэтому readonly ставим на ПОЛЯ формы, кнопки в header
         продолжают работать.

         Гейт по группе: завуч (group_op_timetable_manager) правит всё,
         учителю (group_teacher_timetable) поля readonly.

         Механизм — ДВА дубля каждого поля с groups (как в попапе календаря
         ниже), а НЕ readonly="... user.groups_id ...". В Odoo 18 readonly
         вычисляется на клиенте через evaluateBooleanExpr по evalContext
         record'а, а он содержит только поля записи и parent — `user` там
         нет (web/static/src/model/relational_model/record.js:49-62),
         такое выражение упало бы с EvalError. В проекте таких нет ни
         одного. groups же разбирается на сервере при загрузке вьюхи.
    -->
    <record id="view_session_form_readonly_teacher" model="ir.ui.view">
        <field name="name">op.session.form: поля readonly для учителя</field>
        <field name="model">op.session</field>
        <field name="inherit_id" ref="openeducat_timetable.view_op_session_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//header/field[@name='state']" position="replace">
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirm,start,done"
                        groups="openeducat_timetable.group_op_timetable_manager"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirm,start,done" readonly="1"
                        groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
                <xpath expr="//sheet//field[@name='name']" position="replace">
                    <field name="name" placeholder="e.g. Mathematics Intro"
                        groups="openeducat_timetable.group_op_timetable_manager"/>
                    <field name="name" readonly="1"
                        groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
                <xpath expr="//sheet//field[@name='faculty_id']" position="replace">
                    <field name="faculty_id" widget="many2one_avatar_user"
                        options="{'no_create': True}"
                        groups="openeducat_timetable.group_op_timetable_manager"/>
                    <!-- Учителю поле «Учитель» БЕЗ виджета many2one_avatar_user:
                         этот виджет ПЕРЕЗАПИСЫВАЕТ canOpen — extractProps ставит
                         props.canOpen = fieldInfo.viewType === "form"
                         (web/static/src/views/fields/many2one_avatar/
                         many2one_avatar_field.js:21), из-за чего options.no_open
                         игнорировался и поле оставалось кликабельным (вход в
                         карточку преподавателя). Обычный many2one считает
                         canOpen = !options.no_open (many2one_field.js:380) —
                         работает корректно. Теряется только аватарка. -->
                    <field name="faculty_id"
                        options="{'no_create': True, 'no_open': True}" readonly="1"
                        groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
                <xpath expr="//sheet//field[@name='subject_id']" position="replace">
                    <field name="subject_id" options="{'no_create': True}"
                        groups="openeducat_timetable.group_op_timetable_manager"/>
                    <field name="subject_id" options="{'no_create': True, 'no_open': True}" readonly="1"
                        groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
                <xpath expr="//sheet//field[@name='course_id']" position="replace">
                    <field name="course_id" options="{'no_create': True}"
                        groups="openeducat_timetable.group_op_timetable_manager"/>
                    <field name="course_id" options="{'no_create': True, 'no_open': True}" readonly="1"
                        groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
                <xpath expr="//sheet//field[@name='batch_id']" position="replace">
                    <field name="batch_id"
                        context="{'course_id': course_id, 'get_parent_batch': 1}"
                        options="{'no_create': True}"
                        groups="openeducat_timetable.group_op_timetable_manager"/>
                    <field name="batch_id" readonly="1"
                        context="{'course_id': course_id, 'get_parent_batch': 1}"
                        options="{'no_create': True, 'no_open': True}"
                        groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
                <xpath expr="//sheet//field[@name='timing_id']" position="replace">
                    <field name="timing_id" options="{'no_create': True}"
                        groups="openeducat_timetable.group_op_timetable_manager"/>
                    <field name="timing_id" options="{'no_create': True, 'no_open': True}" readonly="1"
                        groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
                <xpath expr="//sheet//field[@name='start_datetime']" position="replace">
                    <field name="start_datetime" widget="daterange" required="1"
                        options="{'related_start_date': 'start_datetime', 'show_seconds': False, 'rounding': 10}"
                        groups="openeducat_timetable.group_op_timetable_manager"/>
                    <field name="start_datetime" widget="daterange" readonly="1"
                        options="{'related_start_date': 'start_datetime', 'show_seconds': False, 'rounding': 10}"
                        groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
                <xpath expr="//sheet//field[@name='end_datetime']" position="replace">
                    <field name="end_datetime" widget="daterange" required="1"
                        options="{'related_end_date': 'end_datetime', 'show_seconds': False, 'rounding': 10}"
                        groups="openeducat_timetable.group_op_timetable_manager"/>
                    <field name="end_datetime" widget="daterange" readonly="1"
                        options="{'related_end_date': 'end_datetime', 'show_seconds': False, 'rounding': 10}"
                        groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
                <xpath expr="//sheet//field[@name='classroom_id']" position="replace">
                    <field name="classroom_id" options="{'no_create_edit': True}"
                        groups="openeducat_timetable.group_op_timetable_manager"/>
                    <field name="classroom_id" options="{'no_create_edit': True, 'no_open': True}" readonly="1"
                        groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
                <!-- «Разрешить совмещение» / «Запретить совмещение»: конфликт
                     ресурсов решает завуч, у учителя это не его урок.
                     Таких полей ДВА — по одному в каждом баннере, и
                     позиционные xpath '(...)[1]' / '(...)[2]' отрабатывают
                     не предсказуемо (один узел заменялся дважды, второй
                     оставался редактируемым — поймано на test4). Поэтому
                     целимся в баннеры по классам: alert-danger = «конфликт
                     обнаружен», alert-success = «совмещение разрешено».
                     Третье вхождение (invisible="1", без widget) служебное. -->
                <xpath expr="//div[hasclass('alert-danger')]//field[@name='conflict_override']" position="replace">
                    <field name="conflict_override" widget="boolean_toggle"
                        groups="openeducat_timetable.group_op_timetable_manager"/>
                    <field name="conflict_override" widget="boolean_toggle" readonly="1"
                        groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
                <xpath expr="//div[hasclass('alert-success')]//field[@name='conflict_override']" position="replace">
                    <field name="conflict_override" widget="boolean_toggle"
                        groups="openeducat_timetable.group_op_timetable_manager"/>
                    <field name="conflict_override" widget="boolean_toggle" readonly="1"
                        groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
            </data>
        </field>
    </record>

    <!-- ===== op.session: попап урока в календаре — read-only без админа =====

         Клик по уроку в «Расписании» открывает НЕ форму, а popover
         (web.CalendarCommonPopover). Он строится из <field> внутри <calendar>:
         значения рендерятся read-only-виджетом, где many2one остаётся
         ссылкой (кликабельной), а в футере всегда горит кнопка Edit —
         CalendarCommonPopover.isEventEditable в Odoo 18 жёстко `return true`.

         Здесь: убираем ссылку у many2one (no_open) для всех, кроме завуч.
         Кнопку Edit убирает session_calendar.js (isEventEditable через
         hasEditPermission) — из XML это не лечится.
    -->
    <record id="view_session_calendar_popover_readonly" model="ir.ui.view">
        <field name="name">Попап урока в календаре: поля без ссылок. Расписание</field>
        <field name="model">op.session</field>
        <field name="inherit_id" ref="openeducat_timetable.view_op_session_calendar"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='course_id']" position="replace">
                    <field name="course_id" filters="1"
                           groups="openeducat_timetable.group_op_timetable_manager"/>
                    <field name="course_id" filters="1" options="{'no_open': True}"
                           groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
                <xpath expr="//field[@name='faculty_id']" position="replace">
                    <field name="faculty_id" avatar_field="image_128" filters="1"
                           groups="openeducat_timetable.group_op_timetable_manager"/>
                    <field name="faculty_id" avatar_field="image_128" filters="1"
                           options="{'no_open': True}"
                           groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
                <xpath expr="//field[@name='subject_id']" position="replace">
                    <field name="subject_id" filters="1"
                           groups="openeducat_timetable.group_op_timetable_manager"/>
                    <field name="subject_id" filters="1" options="{'no_open': True}"
                           groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
                <xpath expr="//field[@name='classroom_id']" position="replace">
                    <field name="classroom_id" filters="1"
                           groups="openeducat_timetable.group_op_timetable_manager"/>
                    <field name="classroom_id" filters="1" options="{'no_open': True}"
                           groups="!openeducat_timetable.group_op_timetable_manager"/>
                </xpath>
            </data>
        </field>
    </record>

    <!-- ===== op.session: чаттер скрыт от учеников ===== -->
    <record id="view_session_hide_chatter" model="ir.ui.view">
        <field name="name">Отключаем чаттер для Учеников</field>
        <field name="model">op.session</field>
        <field name="inherit_id" ref="openeducat_timetable.view_op_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//chatter" position="attributes">
                <attribute name="groups">!openeducat_core.group_op_students</attribute>
            </xpath>
        </field>
    </record>

    <!-- ===== op.faculty: канбан — ученикам шаблон без открытия карточки ===== -->
    <record id="view_faculty_kanban_student" model="ir.ui.view">
        <field name="name">Ограничиваем доступ к канбану для Учеников</field>
        <field name="model">op.faculty</field>
        <field name="inherit_id" ref="openeducat_core.kanban_view_faculty"/>
        <field name="arch" type="xml">
            <data>
                <!-- Скрываем оригинальный шаблон для студентов -->
                <xpath expr="//kanban/templates/t[@t-name='card']" position="attributes">
                    <attribute name="groups">!openeducat_core.group_op_students</attribute>
                </xpath>

                <!-- Шаблон для студентов БЕЗ класса oe_kanban_global_click -->
                <xpath expr="//kanban/templates" position="inside">
                    <t t-name="card" groups="openeducat_core.group_op_students" class="flex-row">
                        <!-- ВАЖНО: Нет класса oe_kanban_global_click! -->
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <aside class="o_kanban_aside_full">
                            <t t-if="record.image_1920.value">
                                <div class="o_kanban_image_fill position-relative w-100">
                                    <field name="image_1920" alt="Contact image" class="h-100" widget="image" options="{'img_class': 'object-fit-cover'}"/>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="o_kanban_image_fill position-relative w-100">
                                    <field name="avatar_128" class="h-100" widget="image" options="{'img_class': 'object-fit-cover'}"/>
                                </div>
                            </t>
                        </aside>
                        <main class="ml16 ps-2 ps-md-0">
                            <div class="mb-1">
                                <field name="name" class="mb-0 fw-bold fs-5"/>
                            </div>
                            <div t-if="record.city.raw_value or record.country_id.raw_value">
                                <field name="city"/>
                                <span t-if="record.city.raw_value and record.country_id.raw_value">, </span>
                                <field name="country_id"/>
                            </div>
                            <field name="email" class="text-truncate"/>
                            <footer><field name="activity_ids" widget="kanban_activity" class="ms-auto mt-auto" style="padding-bottom:6px;"/></footer>
                        </main>
                    </t>
                </xpath>
            </data>
        </field>
    </record>

    <!-- ===== op.student: чаттер скрыт от учеников ===== -->
    <record id="view_student_hide_chatter" model="ir.ui.view">
        <field name="name">Отключаем чаттер для учеников</field>
        <field name="model">op.student</field>
        <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//chatter" position="attributes">
                <attribute name="groups">!openeducat_core.group_op_students</attribute>
            </xpath>
        </field>
    </record>

    <!-- ===== op.media.movement: кнопки выдачи/приёма для учителей библиотеки ===== -->
    <record id="view_media_movement_teacher_buttons" model="ir.ui.view">
        <field name="name">Добавление группы Учителя</field>
        <field name="model">op.media.movement</field>
        <field name="inherit_id" ref="openeducat_library.view_op_media_movement_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//header/button[@name='issue_media']" position="attributes">
                    <attribute name="groups">openeducat_library.group_op_library,openeducat_assignment.group_teacher_assignment</attribute>
                </xpath>
                <xpath expr="//header/button[@name='410']" position="attributes">
                    <attribute name="groups">openeducat_library.group_op_library,openeducat_assignment.group_teacher_assignment</attribute>
                </xpath>
            </data>
        </field>
    </record>

    <!-- ===== op.assignment.sub.line: оценка/примечание у учеников readonly ===== -->
    <record id="view_assignment_sub_line_marks_readonly" model="ir.ui.view">
        <field name="name">Только для чтения студентов поля оценка и примечание</field>
        <field name="model">op.assignment.sub.line</field>
        <field name="inherit_id" ref="openeducat_assignment.view_op_assignment_sub_line_form"/>
        <field name="arch" type="xml">
            <data>
                <!-- Поле Оценка для студентов - только для чтения -->
                <xpath expr="//field[@name='marks']" position="attributes">
                    <attribute name="readonly">state == 'accept' or True</attribute>
                    <attribute name="groups">openeducat_core.group_op_students</attribute>
                </xpath>

                <!-- Для остальных пользователей - редактируемое -->
                <xpath expr="//field[@name='marks']" position="after">
                    <field name="marks" readonly="state == 'accept'" groups="!openeducat_core.group_op_students"/>
                    <field name="marks_2" readonly="state == 'accept'" groups="!openeducat_core.group_op_students"/>
                </xpath>

                <!-- ДЗ 2 — только для чтения у студентов (как и ДЗ 1) -->
                <xpath expr="//field[@name='marks_2']" position="attributes">
                    <attribute name="groups">openeducat_core.group_op_students</attribute>
                </xpath>

                <!-- Поле Примечание для студентов - только для чтения -->
                <xpath expr="//field[@name='note']" position="attributes">
                    <attribute name="readonly">True</attribute>
                    <attribute name="groups">openeducat_core.group_op_students</attribute>
                </xpath>
            </data>
        </field>
    </record>
</odoo>
