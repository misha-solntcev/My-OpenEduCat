<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!--
        ROST School: безопасность — record rules, implied-чейн ролей, ограничение системных меню.

        Пер-module группы (group_teacher_* / group_student_*) переехали в свои модули
        2026-08-28: rost_school_access зависит от OE-модулей, поэтому ACL тех модулей
        ссылаются на группы в них же (разрыв циклической зависимости для fresh install).

        Ученик (openeducat_core.group_op_students): read-only на свои данные.
        Учитель (group_op_faculty): видит всё, редактирует только свои записи.
        Родитель (group_op_parent_rost): видит то же, что ученик, но по своим детям.
    -->

    <!-- ==================== ГРУППЫ ==================== -->

    <!-- Родитель: наследует Student (те же меню и read-ACL), rule сужает до своих детей -->
    <record id="group_op_parent_rost" model="res.groups">
        <field name="name">Родитель</field>
        <field name="category_id" ref="openeducat_core.module_category_openeducat"/>
        <field name="implied_ids" eval="[(4, ref('openeducat_core.group_op_students'))]"/>
        <field name="comment">Родитель: видит данные своих детей (только чтение)</field>
    </record>

    <!-- ==================== IMPLIED-ЧЕЙН РОЛЕЙ ====================
         «Учителя»/«Ученик» выдают пермодульные галочки (группы живут в OE-модулях).
         group_student_exam НЕ входит: экзамены включаются админом вручную. -->
    <record id="openeducat_core.group_op_faculty" model="res.groups">
        <field name="implied_ids"
               eval="[(4, ref('openeducat_timetable.group_teacher_timetable')), (4, ref('openeducat_attendance.group_teacher_attendance')), (4, ref('openeducat_assignment.group_teacher_assignment')), (4, ref('openeducat_exam.group_teacher_exam')), (4, ref('openeducat_library.group_teacher_library')), (4, ref('openeducat_activity.group_teacher_activity')), (4, ref('openeducat_classroom.group_teacher_classroom')), (4, ref('openeducat_facility.group_teacher_facility'))]"/>
    </record>
    <record id="openeducat_core.group_op_students" model="res.groups">
        <field name="implied_ids"
               eval="[(4, ref('openeducat_timetable.group_student_timetable')), (4, ref('openeducat_attendance.group_student_attendance')), (4, ref('openeducat_assignment.group_student_assignment')), (4, ref('openeducat_library.group_student_library'))]"/>
    </record>

    <!-- ==================== RECORD RULES: УЧЕНИК ==================== -->

    <!-- Ученик видит только свой контакт -->
    <!-- Ученик: read всех контактов (нужно Discuss — авторы сообщений),
         write/create/unlink запрещены полностью (ACL группы 197 на res.partner
         отсутствуют; правило ниже только сужает read-домен не требуется).
         Правило оставлено пустым доменом нельзя — вместо него просто нет write. -->
    <record model="ir.rule" id="student_partner_access_restriction">
        <field name="name">Students: Partner Read (for Discuss authors)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_students'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Ученикам закрыт доступ к сотрудникам -->
    <record model="ir.rule" id="student_employee_access_restriction">
        <field name="name">Students: No Employee Access</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_students'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
    </record>

    <!-- Ученик видит только свою учётную запись -->
    <record model="ir.rule" id="student_users_access_restriction">
        <field name="name">Students: Own User Record Only</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_students'))]"/>
        <field name="domain_force">[('id', '=', user.id)]</field>
    </record>

    <!-- Ученик видит только свою компанию -->
    <record model="ir.rule" id="student_company_access_restriction">
        <field name="name">Students: Limited Company Access</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_students'))]"/>
        <field name="domain_force">[('id', 'in', company_ids)]</field>
    </record>

    <!-- Ученик видит только свои оценки (op.subject.grades, модель из openeducat_attendance).
         Без этого правила видны оценки ВСЕЙ школы. -->
    <record model="ir.rule" id="student_own_grades_rule">
        <field name="name">Students: Own Grades Only</field>
        <field name="model_id" ref="openeducat_attendance.model_op_subject_grades"/>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_students'))]"/>
        <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Журналы уроков и электронный дневник закрыты для учеников полностью:
         там оценки всего класса. Свои оценки ученик видит в Успеваемости
         (op.subject.grades, правило выше). -->
    <record model="ir.rule" id="student_no_attendance_line_rule">
        <field name="name">Students: Own Attendance Lines Only</field>
        <field name="model_id" ref="openeducat_attendance.model_op_attendance_line"/>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_students'))]"/>
        <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record model="ir.rule" id="student_no_attendance_sheet_rule">
        <field name="name">Students: No Attendance Sheets</field>
        <field name="model_id" ref="openeducat_attendance.model_op_attendance_sheet"/>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_students'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Экзамены: правило student_no_exam_rule удалено 2026-08-26 —
         доступ управляется галочкой «Ученик» в секции Exam
         (group_student_exam, не входит в implied). Меню Экзамены скрыто. -->

    <!-- Библиотека: ученик видит только свои выдачи книг -->
    <record model="ir.rule" id="student_own_media_movement_rule">
        <field name="name">Students: Own Media Movements Only</field>
        <field name="model_id" ref="openeducat_library.model_op_media_movement"/>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_students'))]"/>
        <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Библиотека: карточка только своя -->
    <record model="ir.rule" id="student_own_library_card_rule">
        <field name="name">Students: Own Library Card Only</field>
        <field name="model_id" ref="openeducat_library.model_op_library_card"/>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_students'))]"/>
        <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ==================== RECORD RULES: УЧИТЕЛЬ ==================== -->

    <!-- Учитель: write только на свои журналы посещаемости -->
    <record model="ir.rule" id="faculty_attendance_sheet_own_write">
        <field name="name">Faculty: Edit Own Attendance Sheets Only</field>
        <field name="model_id" ref="openeducat_attendance.model_op_attendance_sheet"/>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
        <field name="domain_force">[('faculty_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record model="ir.rule" id="faculty_attendance_line_own_write">
        <field name="name">Faculty: Edit Own Attendance Lines Only</field>
        <field name="model_id" ref="openeducat_attendance.model_op_attendance_line"/>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
        <field name="domain_force">[('attendance_id.faculty_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- ==================== RECORD RULES: РОДИТЕЛЬ ==================== -->
    <!-- Механика: op_parent.user_id -> юзер родителя; при создании юзера
         openeducat_parent заполняет res.users.child_ids юзерами студентов.
         Поэтому "свои дети" = student.user_id in user.child_ids. -->

    <record model="ir.rule" id="parent_student_children_only">
        <field name="name">Parents: Own Children Only</field>
        <field name="model_id" ref="openeducat_core.model_op_student"/>
        <field name="groups" eval="[(4, ref('group_op_parent_rost'))]"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('user_id', 'in', user.child_ids.ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- ==================== СИСТЕМНЫЕ МЕНЮ ODOO ==================== -->
    <!-- Убираем "Внутренний пользователь" из групп меню и оставляем
         только группы, которых у учеников нет. -->

    <!-- Контакты: только менеджеры партнёров (админы). Ученикам и учителям
         приложение скрыто; доступ к нужным контактам — через карточки SIS
         (m2o partner_id), read по ACL роли, write только свой контакт. -->
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('base.group_partner_manager')])]"/>
    </record>

    <!-- Учитель редактирует только свой контакт партнёра -->
    <record model="ir.rule" id="faculty_own_partner_rule">
        <field name="name">Faculty: Own Partner Only</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_faculty'))]"/>
        <field name="domain_force">[('id','=',user.partner_id.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Бэк-офис: обход teacher-ограничения на контакты. Правила групп
         объединяются через OR — это правило-«пустышка» нейтрализует
         faculty_own_partner_rule для администратора бэк-офиса (иначе
         он не может создать контакт ученика при приёме, см. 2026-08-31). -->
    <record model="ir.rule" id="back_office_all_partners_rule">
        <field name="name">Back Office: All Partners</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(4, ref('openeducat_core.group_op_back_office_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Сотрудники: убрать от учеников (HR-данные). Оставляем HR-офицера и админа -->
    <record id="hr.menu_hr_root" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('hr.group_hr_user'), ref('hr.group_hr_manager')])]"/>
    </record>

    <!-- Трекер ссылок: только администрация -->
    <record id="utm.menu_link_tracker_root" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('openeducat_core.group_op_back_office_admin')])]"/>
    </record>
</odoo>
