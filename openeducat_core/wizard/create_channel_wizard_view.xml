<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_create_channel_wizard_form" model="ir.ui.view">
        <field name="name">create.channel.wizard.form</field>
        <field name="model">create.channel.wizard</field>
        <field name="arch" type="xml">
            <form string="Создание каналов чата">
                <sheet>
                    <group string="Выбор периода и классов">
                        <field name="academic_year_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="course_ids" widget="many2many_tags"
                               placeholder="Выберите параллели/курсы..."
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>

                    <group string="Общий канал школы">
                        <field name="create_general_channel"/>
                        <field name="general_channel_name" invisible="not create_general_channel"/>
                    </group>

                    <group string="Настройки подписок">
                        <field name="subscribe_students"/>
                        <field name="subscribe_teachers"/>
                    </group>

                    <group string="Классы и участники">
                        <field name="course_line_ids" options="{'no_create': True}">
                            <list editable="bottom">
                                <field name="academic_year_id" invisible="1" optional="hide"/>
                                <field name="course_id" invisible="1" optional="hide"/>
                                <field name="batch_id" invisible="1"/>
                                <field name="subject_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="student_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="faculty_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="student_count" string="Учеников" optional="hide"/>
                                <field name="faculty_count" string="Учителей" optional="hide"/>
                                <field name="subject_count" string="Предметов" optional="hide"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_create_channels" type="object"
                            string="Создать / Обновить каналы" class="btn-primary" icon="fa-comments"/>
                    <button string="Отмена" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_create_channels" model="ir.actions.act_window">
        <field name="name">Создать каналы чата</field>
        <field name="res_model">create.channel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_create_channel_wizard_form"/>
    </record>

    <record id="view_course_form_inherit_channel_button" model="ir.ui.view">
        <field name="name">op.course.form.inherit.channel</field>
        <field name="model">op.course</field>
        <field name="inherit_id" ref="openeducat_core.view_op_course_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_create_channels)d"
                    string="Создать каналы"
                    type="action"
                    groups="openeducat_core.group_op_back_office_admin"
                    class="oe_highlight"
                    icon="fa-plus" />
            </xpath>
        </field>
    </record>

    <record id="menu_create_channels_from_discuss_config"
        model="ir.ui.menu">
        <field name="name">Создать каналы</field>
        <field name="parent_id" ref="mail.menu_configuration"/>
        <field name="action" ref="action_create_channels"/>
        <field name="sequence">54</field>
        <field name="groups_id" eval="[(4, ref('base.group_system')), (4, ref('openeducat_core.group_op_back_office_admin'))]"/>
    </record>
</odoo>