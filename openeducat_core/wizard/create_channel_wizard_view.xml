<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_create_channel_wizard_form" model="ir.ui.view">
        <field name="name">create.channel.wizard.form</field>
        <field name="model">create.channel.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Chat Channels">
                <sheet>
                    <group string="Выбор класса">
                        <field name="course_ids" string="Классы" widget="many2many_tags"
                               options="{'no_create_edit': True, 'no_open': True}"
                               context="{'no_quick_create': True}" />
                    </group>

                    <group string="General Channel" col="1">
                        <field name="create_general_channel" />
                        <field name="general_channel_name"
                               invisible="not create_general_channel" />
                        <field name="subscribe_all_to_general"
                               invisible="not create_general_channel" />
                    </group>

                    <notebook>
                        <page string="Предметы">
                            <group>
                                <field name="subject_ids"
                                    string="Предметы"
                                    widget="many2many_tags"
                                    domain="subject_domain"
                                    options="{'no_create_edit': True, 'no_open': True}" />
                            </group>
                            <group>
                                <field
                                    name="subscribe_students_to_subjects"
                                    string="Подписать учеников в каналы по предметам" />
                                <field
                                    name="subscribe_teachers_to_subjects"
                                    string="Подписать учителей в каналы по предметам" />
                            </group>
                        </page>

                        <page string="Ученики">
                            <group>
                                <field name="student_ids"
                                    string="Ученики"
                                    widget="many2many_tags"
                                    domain="student_domain"
                                    options="{'no_create_edit': True, 'no_open': True}" />
                            </group>
                        </page>

                        <page string="Учителя">
                            <group string="Teachers to Subscribe">
                                <field name="faculty_ids"
                                    widget="many2many_tags"
                                    domain="faculty_domain"
                                    options="{'no_create_edit': True, 'no_open': True}" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="action_create_channels" type="object"
                        string="Create Channels" class="btn-primary"
                        icon="fa-plus" />
                    <button string="Cancel" class="btn-secondary"
                        special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_create_channel_wizard">
        <field name="name">Create Chat Channels</field>
        <field name="res_model">create.channel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_course_ids': active_ids}</field>
        <field name="view_id" ref="view_create_channel_wizard_form" />
    </record>

    <!-- Button on op.course form -->
    <record id="view_course_form_inherit_channel_button" model="ir.ui.view">
        <field name="name">op.course.form.inherit.channel</field>
        <field name="model">op.course</field>
        <field name="inherit_id" ref="openeducat_core.view_op_course_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <button name="%(openeducat_core.action_create_channel_wizard)d"
                    string="Create Channels"
                    type="action"
                    groups="openeducat_core.group_op_back_office_admin"
                    class="oe_highlight"
                    icon="fa-plus" />
            </xpath>
        </field>
    </record>
</odoo>