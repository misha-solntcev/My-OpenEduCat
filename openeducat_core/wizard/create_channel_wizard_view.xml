<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_create_channel_wizard_form" model="ir.ui.view">
        <field name="name">create.channel.wizard.form</field>
        <field name="model">create.channel.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Chat Channels">
                <sheet>
                    <group string="Выбор класса">
                        <field name="academic_year_id"
                            string="Учебный год"
                            options="{'no_create_edit': True, 'no_open': True}" />
                        <field name="course_ids" string="Классы/Курсы"
                            widget="many2many_tags"
                            placeholder="Выберите классы/параллели..."
                            options="{'no_create_edit': True, 'no_open': True}" />
                    </group>

                    <group string="Общий канал" col="1">
                        <field name="create_general_channel"
                            string='Создать общий канал' />
                        <field name="general_channel_name"
                            string='Имя канала'
                            invisible="not create_general_channel" />
                    </group>

                    <!-- Автозаполняемые строки: tree inline-editable -->
                    <group string="Классы/Потоки">
                        <field name="course_line_ids"
                            options="{'no_create': True, 'no_create_edit': True}">
                            <list editable="bottom">
                                <field name="batch_id"
                                    string="Класс/Поток"
                                    options="{'no_create_edit': True, 'no_open': True}"/>
                                <field name="subject_ids"
                                    string="Предметы"
                                    widget="many2many_tags"
                                    options="{'no_create_edit': True, 'no_open': True}"/>
                                <field name="student_ids"
                                    string="Ученики"
                                    widget="many2many_tags"
                                    options="{'no_create_edit': True, 'no_open': True}"/>
                                <field name="faculty_ids"
                                    string="Учителя"
                                    widget="many2many_tags"
                                    options="{'no_create_edit': True, 'no_open': True}"/>
                                <field name="subscribe_students_to_subjects"
                                    string="Студенты к предметам"/>
                                <field name="subscribe_teachers_to_subjects"
                                    string="Учителя к предметам"/>
                            </list>
                        </field>
                    </group>

                </sheet>
                <footer>
                    <button name="action_create_channels" type="object"
                        string="Create Channels" class="btn-primary"
                        icon="fa-plus" />
                    <button string="Cancel" class="btn-secondary"
                        special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_create_channels">
        <field name="name">Create Chat Channels</field>
        <field name="res_model">create.channel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
        <field name="view_id" ref="view_create_channel_wizard_form" />
    </record>

    <!-- Button on op.course form -->
    <record id="view_course_form_inherit_channel_button" model="ir.ui.view">
        <field name="name">op.course.form.inherit.channel</field>
        <field name="model">op.course</field>
        <field name="inherit_id" ref="openeducat_core.view_op_course_form" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button
                    name="%(action_create_channels)d"
                    string="Create Channels"
                    type="action"
                    groups="openeducat_core.group_op_back_office_admin"
                    class="oe_highlight"
                    icon="fa-plus" />
            </xpath>
        </field>
    </record>

    <!-- Menu item in Communication → Configuration → Create Channels -->
    <record id="menu_create_channels_from_discuss_config"
        model="ir.ui.menu">
        <field name="name">Создать каналы</field>
        <field name="parent_id" ref="mail.menu_configuration"/>
        <field name="action" ref="action_create_channels"/>
        <field name="sequence">54</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>