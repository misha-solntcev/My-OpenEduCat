<?xml version="1.0" encoding="UTF-8"?>
<odoo>

        <record id="kanban_view_student" model="ir.ui.view">
            <field name="name">Student Kanban</field>
            <field name="model">op.student</field>
            <field name="arch" type="xml">
                <kanban sample="1">
                    <field name="id"/>
                    <field name="image_1920"/>
                    <templates>
                        <t t-name="card" class="flex-row">
                            <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                           <aside class="o_kanban_aside_full">
                                <t t-if="record.image_1920.value">
                                    <div class="o_kanban_image_fill position-relative w-100">
                                        <field name="image_1920" alt="Contact image" class="h-100" widget="image" options="{'img_class': 'object-fit-cover'}"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="o_kanban_image_fill position-relative w-100">
                                        <field name="avatar_128" class="h-100" widget="image" options="{'img_class': 'object-fit-cover'}"/>
                                    </div>
                                </t>
                            </aside>
                            <main class="ml16 ps-2 ps-md-0">
                                <div class="mb-1">
                                    <field name="name" class="mb-0 fw-bold fs-5"/>
                                </div>
                                <div t-if="record.city.raw_value or record.country_id.raw_value">
                                    <field name="city"/>
                                    <span t-if="record.city.raw_value and record.country_id.raw_value">, </span>
                                    <field name="country_id"/>
                                </div>
                                <field name="email" class="text-truncate"/>
                                <footer><field name="activity_ids" widget="kanban_activity" class="ms-auto mt-auto" style="padding-bottom:6px;"/></footer>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_op_student_tree" model="ir.ui.view">
            <field name="name">op.student.list</field>
            <field name="model">op.student</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Student">
                    <field name="title" optional="show"/>
                    <field name="name"/>
                    <field name="gender" optional="hide"/>
                    <field name="birth_date" optional="hide"/>
                    <field name="gr_no" optional="hide"/>
                    <field name="mobile" optional="hide"/>
                    <field name="email" optional="hide"/>
                    <field name="blood_group"/>
                    <field name="emergency_contact"/>
                    <field name="nationality"/>
                    <field name="lang"/>
                    <field name="state" widget="badge"/>
                    <field name="active_course_id" optional="hide"/>
                    <field name="last_active_course_id" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_op_student_form" model="ir.ui.view">
            <field name="name">op.student.form</field>
            <field name="model">op.student</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Student">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,admission,studying,pass_out,alumni"/>
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                        </div>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                                invisible ="active == True"/>
                        <div style="width:100%;" class="row align-items-center">
                            <div class="mb16 col-8 col-lg-10 px-4">
                                <div class="d-flex student-name">
                                    <h1 class="">
                                        <field name="title" widget="inline_many2one" placeholder="Title"/>
                                    </h1>
                                    <div class="">
                                        <h1 class="d-lg-flex flex-wrap align-items-center gap-1">
                                            <field name="name" placeholder="Name" required="1" invisible="1"/>
                                            <field name="first_name" widget="inline_char" required="1" placeholder="First Name"/>
                                            <field name="middle_name" widget="inline_char" placeholder="Middle Name"/>
                                            <field name="last_name" widget="inline_char" placeholder="Last Name"/>
                                        </h1>
                                    </div>
                                </div>
                            </div>
                            <div class="col-4 col-lg-2">
                                <field name="image_1920" widget="image" class="oe_left oe_avatar" />
                            </div>
                        </div>
                        <notebook colspan="4">
                            <page name="personal_information" string="Personal Information">
                                <group name="personal_detail">
                                    <group>
                                        <field name="gender" required="1"/>
                                        <field name="birth_date"/>
                                        <label for="type"/>
                                        <div name="div_type">
                                            <field class="oe_inline" name="type"/>
                                        </div>
                                        <label for="street" string="Address"/>
                                        <div name="o_address_format">
                                            <field name="street" placeholder="Street..."/>
                                            <field name="street2" placeholder="Street2"/>
                                            <div class="address_format">
                                                <field name="city" placeholder="City" style="width: 40%"/>
                                                <field name="state_id" class="oe_no_button" placeholder="State"
                                                       style="width: 37%" options="{'no_open': True}"/>
                                                <field name="zip" placeholder="ZIP" style="width: 20%"/>
                                            </div>
                                            <field name="country_id" placeholder="Country" class="oe_no_button"
                                                   options="{'no_open': True}"/>
                                        </div>
                                        <field name="emergency_contact" context="{'show_address': 1}"
                                               options="{'always_reload': True}"/>
                                    </group>
                                    <group>
                                        <field name="email"/>
                                        <field name="mobile"/>
                                        <field name="lang"/>
                                        <field name="blood_group"/>
                                        <field name="nationality"/>
                                        <field name="visa_info"/>
                                        <field name="category_id"/>
                                        <field name="user_id" string="User" readonly="1"/>
                                        <field name="partner_id" placeholder="Partner" required="0"/>
                                    </group>
                                    <group string="miscellaneous">
                                        <field name="gr_no"/>
                                        <field name="last_active_course_id" readonly="1"/>
                                        <field name="last_active_academic_year_id" readonly="1"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_op_student_search" model="ir.ui.view">
            <field name="name">op.student.search</field>
            <field name="model">op.student</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Student">
                    <field name="name"/>
                    <field name="active_course_id" string="Класс"/>
                    <field name="state"/>
                    <field name="last_active_course_id" string="Last Course"/>
                    <field name="last_active_academic_year_id" string="Last Academic Year"/>
                    
                    <group expand="0" string="Group By...">
                        <filter name="current_course" string="Класс"
                                domain="[]" context="{'group_by':'active_course_id'}"/>
                        <filter name="last_course" string="Last Course"
                                domain="[]" context="{'group_by':'last_active_course_id'}"/>
                        <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    </group>
                    <group expand="0" string="Filters">
                        <filter string="2025-2026" name="filter_ay_2025_2026"
                                domain="['|', ('active_academic_year_id', '=', 6), ('last_active_academic_year_id', '=', 6)]"/>
                        <filter string="2026-2027" name="filter_ay_2026_2027"
                                domain="['|', ('active_academic_year_id', '=', 8), ('last_active_academic_year_id', '=', 8)]"/>

                        <separator/>

                        <filter string="1 класс" name="filter_1_klass"
                                domain="['|', ('active_course_id', '=', 15), ('last_active_course_id', '=', 15)]"/>
                        <filter string="2 класс" name="filter_2_klass"
                                domain="['|', ('active_course_id', '=', 18), ('last_active_course_id', '=', 18)]"/>
                        <filter string="3 класс" name="filter_3_klass"
                                domain="['|', ('active_course_id', '=', 19), ('last_active_course_id', '=', 19)]"/>
                        <filter string="4 класс" name="filter_4_klass"
                                domain="['|', ('active_course_id', '=', 20), ('last_active_course_id', '=', 20)]"/>
                        <filter string="5 класс" name="filter_5_klass"
                                domain="['|', ('active_course_id', '=', 21), ('last_active_course_id', '=', 21)]"/>
                        <filter string="6 класс" name="filter_6_klass"
                                domain="['|', ('active_course_id', '=', 22), ('last_active_course_id', '=', 22)]"/>
                        <filter string="7 класс" name="filter_7_klass"
                                domain="['|', ('active_course_id', '=', 23), ('last_active_course_id', '=', 23)]"/>
                        <filter string="8 класс" name="filter_8_klass"
                                domain="['|', ('active_course_id', '=', 24), ('last_active_course_id', '=', 24)]"/>
                        <filter string="9 класс" name="filter_9_klass"
                                domain="['|', ('active_course_id', '=', 25), ('last_active_course_id', '=', 25)]"/>
                        <filter string="10 класс" name="filter_10_klass"
                                domain="['|', ('active_course_id', '=', 26), ('last_active_course_id', '=', 26)]"/>
                        <filter string="11 класс" name="filter_11_klass"
                                domain="['|', ('active_course_id', '=', 27), ('last_active_course_id', '=', 27)]"/>

                        <separator/>

                        <filter string="Studying" name="filter_studying"
                                domain="[('state', '=', 'studying')]"/>
                        <filter string="Admission" name="filter_admission"
                                domain="[('state', '=', 'admission')]"/>
                        <filter string="Pass Out" name="filter_pass_out"
                                domain="[('state', '=', 'pass_out')]"/>
                        <filter string="Alumni" name="filter_alumni"
                                domain="[('state', '=', 'alumni')]"/>
                        <filter string="All Active Students" name="filter_all_active"
                                domain="[('state', 'in', ['studying', 'admission', 'pass_out', 'alumni'])]"/>
                    </group>
                    <searchpanel string="Класс" >
                        <field name="active_course_id" string="Класс" select="multi" icon="fa-graduation-cap" enable_counters="1" />
                    </searchpanel>
                </search>
            </field>
        </record>

        <record id="student_view_activity" model="ir.ui.view">
            <field name="name">op.students.activity</field>
            <field name="model">op.student</field>
            <field name="arch" type="xml">
                <activity string="Contacts">
                    <field name="id"/>
                    <templates>
                        <div t-name="activity-box">
                            <img t-att-src="activity_image('op.student', 'image_1920', record.id.raw_value)" role="img" t-att-title="record.name.value" t-att-alt="record.name.value"/>
                            <div class="ms-2">
                                <field name="name" display="full" class="o_text_block"/>
                            </div>
                        </div>
                    </templates>
                </activity>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_op_student_view">
            <field name="name">Students</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.student</field>
            <field name="path">students</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">kanban,list,form,activity</field>
            <field name="search_view_id" ref="view_op_student_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_student_view_form">
            <field name="act_window_id" ref="act_open_op_student_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_op_student_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_student_view_tree">
            <field name="act_window_id" ref="act_open_op_student_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_op_student_tree"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_student_view_kanban">
            <field name="act_window_id" ref="act_open_op_student_view"/>
            <field name="sequence" eval="5"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="kanban_view_student"/>
        </record>

        <record model="ir.actions.act_window" id="act_open_op_student_view_2">
            <field name="name">Students</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.student</field>
            <field name="path">student</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">kanban,list,form,activity</field>
            <field name="search_view_id" ref="view_op_student_search"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

</odoo>