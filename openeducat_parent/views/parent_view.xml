<?xml version="1.0" encoding="UTF-8"?>
<odoo>

        <record model="ir.ui.view" id="parent_student_form_view">
            <field name="name">op.student.form</field>
            <field name="model">op.student</field>
            <field name="inherit_id" ref="openeducat_core.view_op_student_form"/>
            <field name="priority" eval="12"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="get_parent"
                        class="btn oe_stat_button"
                        icon="fa-user-o"
                        type="object"
                        groups="openeducat_parent.group_op_parent_manager">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_text">Parents</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

        <record id="view_op_parent_tree" model="ir.ui.view">
            <field name="name">op.parent.list</field>
            <field name="model">op.parent</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <list string="Parent">
                    <field name="name"/>
                    <field name="mobile" required="1"/>
                    <field name="student_ids" widget="many2many_tags"/>
                </list>
            </field>
        </record>

        <record id="view_op_parent_form" model="ir.ui.view">
            <field name="name">op.parent.form</field>
            <field name="model">op.parent</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <form string="Parent">
                    <header>
                        <button type="object" name="create_parent_user"
                                string="Create Parent User"
                                groups="openeducat_parent.group_op_parent_manager"
                                class="oe_highlight"
                                invisible="user_id != False"/>
                    </header>
                    <sheet>
                        <field name="active" invisible="1"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                                invisible="active == True"/>
                        <group>
                            <group>
                                <!-- Контакт — владелец имени/телефона/фото.
                                     name — related-строка, нужна во вьюхе,
                                     чтобы заголовок записи обновлялся без
                                     перезагрузки. -->
                                <field name="partner_id" placeholder="Контакт"/>
                                <field name="name" readonly="1" invisible="1"/>
                                <field name="mobile" required="1"/>
                            </group>
                            <group>
                                <field name="user_id" readonly="1"/>
                                <field name="relationship_id" required="1"/>
                            </group>
                        </group>
                        <separator colspan="4" string="Student(s)"/>
                        <field name="student_ids"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_op_parent_search" model="ir.ui.view">
            <field name="name">op.parent.search</field>
            <field name="model">op.parent</field>
            <field name="priority" eval="8"/>
            <field name="arch" type="xml">
                <search string="Parent">
                    <field name="name"/>
                    <field name="student_ids"/>
                    <newline/>
                    <group expand="0" string="Group By...">
                        <filter string="Name" name="group_by_parent_name"
                                domain="[]" context="{'group_by':'name'}"/>
                        <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="act_open_op_parent_view">
            <field name="name">Parents</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">op.parent</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="path">parent</field>
            <field name="search_view_id" ref="view_op_parent_search"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_parent_view_form">
            <field name="act_window_id" ref="act_open_op_parent_view"/>
            <field name="sequence" eval="20"/>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_op_parent_form"/>
        </record>

        <record model="ir.actions.act_window.view" id="act_open_op_parent_view_tree">
            <field name="act_window_id" ref="act_open_op_parent_view"/>
            <field name="sequence" eval="10"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_op_parent_tree"/>
        </record>

        <!-- ================= РОСТ: паспорт, адреса, канбан ================= -->

        <!-- Паспорт и адреса — для договора. Заполняются вкладкой
             «Заявитель» приёмки, при зачислении переносятся сюда; после
             зачисления правятся в карточке родителя (решение 12.11.2026). -->
        <record id="view_op_parent_form_rost" model="ir.ui.view">
            <field name="name">op.parent.form.rost.docs</field>
            <field name="model">op.parent</field>
            <field name="inherit_id" ref="view_op_parent_form"/>
            <field name="arch" type="xml">
                <xpath expr="//separator[@colspan='4']" position="before">
                    <separator colspan="4" string="Паспорт и адреса (для договора)"/>
                    <group>
                        <group>
                            <field name="birth_date"/>
                            <field name="passport_number"/>
                            <field name="passport_issue_date"/>
                            <field name="passport_dept_code"/>
                        </group>
                        <group>
                            <field name="passport_issued_by"/>
                            <field name="address_reg"/>
                            <field name="address_home"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- Канбан родителей — в стиле канбана учеников: фото контакта,
             родство, телефон, число детей. -->
        <record id="kanban_view_op_parent" model="ir.ui.view">
            <field name="name">op.parent.kanban.rost</field>
            <field name="model">op.parent</field>
            <field name="arch" type="xml">
                <!-- default_order: name — related-строка (store=True), в SQL
                     это обычное текстовое поле, алфавит по имени контакта -->
                <kanban default_order="name">
                    <field name="image_1920"/>
                    <field name="avatar_128"/>
                    <field name="relationship_id"/>
                    <field name="mobile"/>
                    <field name="student_count"/>
                    <field name="active"/>
                    <templates>
                        <t t-name="card" class="flex-row">
                            <widget name="web_ribbon" title="Archived"
                                    bg_color="text-bg-danger"
                                    invisible="active"/>
                            <aside class="o_kanban_aside_full">
                                <t t-if="record.image_1920.value">
                                    <div class="o_kanban_image_fill position-relative w-100">
                                        <field name="image_1920" alt="Родитель"
                                               class="h-100" widget="image"
                                               options="{'img_class': 'object-fit-cover'}"/>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="o_kanban_image_fill position-relative w-100">
                                        <field name="avatar_128" alt="Родитель"
                                               class="h-100" widget="image"
                                               options="{'img_class': 'object-fit-cover'}"/>
                                    </div>
                                </t>
                            </aside>
                            <main class="ml16 ps-2 ps-md-0">
                                <div class="mb-1">
                                    <field name="name" class="mb-0 fw-bold fs-5"/>
                                </div>
                                <div>
                                    <field name="relationship_id"
                                           options="{'no_open': True}"/>
                                </div>
                                <div t-if="record.mobile.raw_value" class="text-muted">
                                    <field name="mobile"/>
                                </div>
                                <div>
                                    Детей: <field name="student_count"/>
                                </div>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Канбан — первым видом в меню «Родители».
             Строки view_ids (seq 10 list / 20 form) всегда идут первыми
             в computed views, view_mode лишь дописывает недостающие
             режимы в конец — поэтому нужен отдельный view_ids-ряд для
             kanban с sequence < 10. -->
        <record model="ir.actions.act_window.view" id="act_open_op_parent_view_kanban_rost">
            <field name="act_window_id" ref="act_open_op_parent_view"/>
            <field name="sequence" eval="5"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="kanban_view_op_parent"/>
        </record>

</odoo>
