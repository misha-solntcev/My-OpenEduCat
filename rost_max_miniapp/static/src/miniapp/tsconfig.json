{
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom"],
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./"],
      "@/shared/*": ["./shared/*"],
      "@/pages/*": ["./pages/*"],
      "@/components/*": ["./shared/components/*"],
      "@/lib/*": ["./shared/lib/*"]
    }
  },
  "include": [
    "App.tsx",
    "main.tsx",
    "pages/**/*.{ts,tsx}",
    "shared/**/*.{ts,tsx}",
    "vite-env.d.ts"
  ]
}
