<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record model="ir.module.category" id="module_category_all_op_discuss">
            <field name="name">Timetable</field>
            <field name="description">Helps you manage your institutes different-different users.</field>
            <field name="sequence">113</field>
            <field name="parent_id" eval="False"/>
        </record>
        <record id="module_category_openeducat_timetable" model="ir.module.category">
            <field name="name">Timetable</field>
            <field name="parent_id" ref="openeducat_timetable.module_category_all_op_discuss"/>
            <field name="sequence">16</field>
        </record>

        <record id="group_op_timetable_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_openeducat_timetable"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
            <field name="implied_ids"
                   eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_op_timetable_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_openeducat_timetable"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
            <field name="implied_ids"
                   eval="[(4, ref('openeducat_timetable.group_op_timetable_user'))]"/>
        </record>

        <!-- Студент видит свои сессии (через user_ids в session) -->
        <record model="ir.rule" id="student_session_rule">
            <field name="name">Student Session rule</field>
            <field name="model_id" ref="model_op_session"/>
            <field name="groups"
                   eval="[(4, ref('openeducat_core.group_op_students'))]"/>
            <field name="domain_force">['|', ('user_ids','in',user.id), ('user_ids','in',user.child_ids.ids)]</field>
        </record>

        <!-- Учитель: ВЕСЬ тайминг школы (матрица 2026-08-23).
             Ограничение «Мои уроки» — дефолтный фильтр my_sessions в act_window,
             снимается пользователем. Редактирование запрещено ACL
             (op_session_faculty = 1,0,0,0). Правило faculty_session_rule
             (срез до своих уроков) удалено 2026-08-31. -->

        <!-- Менеджер видит все сессии -->
        <record model="ir.rule" id="manager_session_rule">
            <field name="name">Manager Session Rule</field>
            <field name="model_id" ref="model_op_session"/>
            <field name="groups"
                   eval="[(4, ref('openeducat_timetable.group_op_timetable_manager'))]"/>
            <field name="domain_force">[(1,'=',1)]</field>
        </record>

        <!-- Пользователь (back_office) видит свои сессии -->
        <record model="ir.rule" id="user_session_rule">
            <field name="name">User Session Rule</field>
            <field name="model_id" ref="model_op_session"/>
            <field name="groups"
                   eval="[(4, ref('openeducat_timetable.group_op_timetable_user'))]"/>
            <field name="domain_force">[('faculty_id.user_id','=',user.id)]</field>
        </record>


    <!-- ==================== ROST per-module role groups ====================
         Перенесены из rost_school_access 2026-08-28 (разрыв циклической зависимости):
         ACL этого модуля ссылаются на эти группы, поэтому они обязаны жить здесь. -->
    <record id="group_teacher_timetable" model="res.groups">
        <field name="name">Учитель</field>
        <field name="category_id" ref="module_category_openeducat_timetable"/>
        <field name="comment">Учитель: работа с расписанием</field>
    </record>
    <record id="group_student_timetable" model="res.groups">
        <field name="name">Ученик</field>
        <field name="category_id" ref="module_category_openeducat_timetable"/>
        <field name="comment">Ученик: просмотр своего расписания</field>
    </record>
</odoo>
