<odoo>

        <template id="report_timetable_student_generate">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="openeducat_core.external_layout_rost">
                        <!-- Единая точка изменения фирменного цвета -->
                        <t t-set="brand" t-value="'#2d4383'"/>
                        <t t-set="doc_subtitle" t-value="'Расписание'"/>

                        <div class="page" style="font-family: Arial, Helvetica, sans-serif;">
                            <div style="text-align: center; margin-bottom: 4px;">
                                <h2 style="font-size: 20px; margin: 0 0 2px;">
                                    <b>Расписание занятий</b>
                                </h2>
                                <div style="font-size: 14px; color: #666;">
                                    <span t-esc="data['course_id'][1]"/>
                                    <t t-if="data.get('batch_id')">
                                        <span> &#183; </span>
                                        <span t-esc="data['batch_id'][1]"/>
                                    </t>
                                    <span> &#183; </span>
                                    <span t-esc="data['start_date']" t-options="{'widget':'date'}"/>
                                    &#8212;
                                    <span t-esc="data['end_date']" t-options="{'widget':'date'}"/>
                                </div>
                            </div>
                            <table width="100%" style="table-layout: fixed; width: 100%; border-collapse: collapse;">
                                <colgroup>
                                    <col style="width: 70px;"/>
                                    <col t-foreach="days" t-as="d"/>
                                </colgroup>
                                <thead>
                                    <tr t-attf-style="background-color: #{brand}; color: white;">
                                        <th style="font-size: 14px; font-weight: 700; padding: 8px 4px; border: 1px solid #ccc; text-align: center;">Время</th>
                                        <t t-foreach="days" t-as="d">
                                            <th style="font-size: 14px; font-weight: 700; padding: 8px 4px; border: 1px solid #ccc; text-align: center;"><span t-out="d[1]"/></th>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="get_object(data)" t-as="a" style="page-break-inside: avoid;">
                                        <td style="font-size: 14px; font-weight: 700; padding: 8px 4px; border: 1px solid #ccc; text-align: center; background-color: #f2f4f8; white-space: nowrap;">
                                            <span t-out="a['name'] if a['name'] else ''"/>
                                        </td>
                                        <t t-foreach="days" t-as="d">
                                            <td style="font-size: 14px; padding: 0; border: 1px solid #ccc; vertical-align: middle;">
                                                <t t-set="lessons" t-value="a['line'].get(d[0])"/>
                                                <t t-foreach="lessons or []" t-as="ls">
                                                    <div style="padding: 7px 8px; text-align: left; line-height: 1.35;">
                                                        <div style="font-weight: 700;"><span t-esc="ls['subject']"/></div>
                                                        <div style="font-size: 12px; color: #555;"><span t-if="ls.get('faculty')" t-esc="ls['faculty']"/></div>
                                                    </div>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

</odoo>
