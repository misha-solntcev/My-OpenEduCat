<odoo>

        <template id="report_timetable_student_generate">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page">

                            <div style="text-align: center; margin-bottom: 14px;">
                                <h2 style="font-size: 22px; margin-bottom: 4px;">
                                    <b>Расписание занятий</b>
                                </h2>
                            </div>
                            <table width="100%" style="margin-bottom: 12px; font-size: 14px;">
                                <tbody>
                                    <tr>
                                        <td>
                                            <b>Класс:</b>
                                            <span t-esc="data['course_id'][1]"/>
                                            <span style="margin-left: 24px;"/>
                                            <b>Группа:</b>
                                            <span t-if="data.get('batch_id')" t-esc="data['batch_id'][1]"/>
                                            <span t-else="">&#8212;</span>
                                        </td>
                                        <td style="text-align: right;">
                                            <b>Период:</b>
                                            <span t-esc="data['start_date']" t-options="{'widget':'date'}"/>
                                            &#8212;
                                            <span t-esc="data['end_date']" t-options="{'widget':'date'}"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="table table-bordered" style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr>
                                        <th style="font-size: 14px; padding: 10px 6px; border: 1px solid #999; background-color: #eeeeee; text-align: center; width: 90px;">Урок</th>
                                        <t t-foreach="days" t-as="d">
                                            <th style="font-size: 14px; padding: 10px 6px; border: 1px solid #999; background-color: #eeeeee; text-align: center;"><span t-out="d[1]"/></th>
                                        </t>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="get_object(data)" t-as="a">
                                        <td style="font-size: 13px; padding: 12px 6px; border: 1px solid #999; text-align: center; font-weight: bold; background-color: #f7f7f7;">
                                            <span t-out="a['name'] if a['name'] else ''"/>
                                        </td>
                                        <t t-foreach="days" t-as="d">
                                            <td style="font-size: 13px; padding: 12px 6px; border: 1px solid #999; text-align: center; vertical-align: middle;">
                                                <span t-esc="a['line'].get(d[0], {'subject': ''})['subject']"/>
                                            </td>
                                        </t>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </t>
            </t>
        </template>

</odoo>
